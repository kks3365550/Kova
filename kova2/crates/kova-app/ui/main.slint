import { ListView, ScrollView } from "std-widgets.slint";

export struct ProfileRow { id: string, name: string, last: string, detail: string }
export struct SnapRow { id: string, repo: string, when: string, name: string, summary: string, verified: string }
export struct OffsiteRow { id: string, name: string, dir: string }
export struct AlertRow { when: string, level: string, message: string, full: string, ack: bool }
export struct BrowseRow { name: string, path: string, is-dir: bool, info: string, selected: bool }
export struct RunRow { id: int, name: string, pct: int, current: string, cancellable: bool }

global Theme {
    in-out property <bool> dark: true;
    out property <color> bg: dark ? #0d1117 : #f3f5f8;
    out property <color> side: dark ? #090c11 : #e7ebf1;
    out property <color> card: dark ? #161b22 : #ffffff;
    out property <color> card-hi: dark ? #1c232c : #eef2f7;
    out property <color> line: dark ? #2a3340 : #d3dae3;
    out property <color> text: dark ? #e6edf3 : #1b2430;
    out property <color> muted: dark ? #8b98a8 : #5d6b7c;
    out property <color> accent: #2f81f7;
    out property <color> ok: #3fb950;
    out property <color> warn: #d29922;
    out property <color> danger: #f85149;
    out property <color> danger-bg: dark ? #3a1a1c : #fde8e8;
}

component Card inherits Rectangle {
    background: Theme.card;
    border-radius: 10px;
    border-width: 1px;
    border-color: Theme.line;
}

component Heading inherits Text {
    color: Theme.text;
    font-size: 15px;
    font-weight: 700;
}

component Hint inherits Text {
    color: Theme.muted;
    font-size: 12px;
    wrap: word-wrap;
}

// kind: 0 보통, 1 주요, 2 위험(복원·삭제)
component Btn inherits Rectangle {
    in property <string> text;
    in property <int> kind: 0;
    callback clicked();
    min-width: lbl.preferred-width + 28px;
    height: 32px;
    border-radius: 6px;
    border-width: 1px;
    background: kind == 1 ? (ta.has-hover ? #4493f8 : Theme.accent) : kind == 2 ? (ta.has-hover ? Theme.danger : Theme.danger-bg) : (ta.has-hover ? Theme.card-hi : Theme.card);
    border-color: kind == 1 ? Theme.accent : kind == 2 ? Theme.danger : Theme.line;
    lbl := Text {
        text: root.text;
        color: kind == 1 ? #ffffff : kind == 2 ? (ta.has-hover ? #ffffff : Theme.danger) : Theme.text;
        font-size: 13px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

component Field inherits Rectangle {
    in-out property <string> text <=> ti.text;
    in property <string> placeholder;
    height: 34px;
    border-radius: 6px;
    border-width: 1px;
    border-color: ti.has-focus ? Theme.accent : Theme.line;
    background: Theme.bg;
    Text {
        x: 10px;
        text: root.placeholder;
        color: Theme.muted;
        font-size: 13px;
        vertical-alignment: center;
        visible: ti.text == "";
    }
    ti := TextInput {
        x: 10px;
        width: parent.width - 20px;
        height: parent.height;
        font-size: 13px;
        color: Theme.text;
        vertical-alignment: center;
        single-line: true;
    }
}

component PathField inherits HorizontalLayout {
    in-out property <string> text <=> f.text;
    in property <string> placeholder;
    in property <string> kind: "folder";
    in property <bool> append: false;
    callback pick(string) -> string;
    spacing: 8px;
    f := Field { placeholder: root.placeholder; horizontal-stretch: 1; }
    Btn {
        text: "찾아보기";
        clicked => {
            let r = root.pick(root.kind);
            if (r != "") {
                f.text = (root.append && f.text != "") ? f.text + ";" + r : r;
            }
        }
    }
}

component Badge inherits Rectangle {
    in property <string> text;
    in property <color> tone: Theme.muted;
    height: 24px;
    border-radius: 12px;
    background: tone.with-alpha(0.18);
    min-width: bl.preferred-width + 20px;
    bl := Text { text: root.text; color: root.tone; font-size: 12px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
}

component NavItem inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked();
    height: 40px;
    background: active ? Theme.card : (ta.has-hover ? Theme.card-hi : transparent);
    border-radius: 8px;
    Rectangle { x: 0px; width: 3px; height: 20px; y: (parent.height - 20px) / 2; border-radius: 2px; background: active ? Theme.accent : transparent; }
    Text {
        x: 16px;
        text: root.text;
        color: active ? Theme.text : Theme.muted;
        font-size: 14px;
        font-weight: active ? 700 : 400;
        vertical-alignment: center;
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

component Stat inherits Card {
    in property <string> label;
    in property <string> value;
    in property <color> tone: Theme.text;
    preferred-width: 1px;
    height: 84px;
    VerticalLayout {
        padding: 14px;
        spacing: 4px;
        Text { text: root.label; color: Theme.muted; font-size: 12px; }
        Text { text: root.value; color: root.tone; font-size: 15px; font-weight: 700; wrap: word-wrap; overflow: elide; }
    }
}

export component MainWindow inherits Window {
    title: "Kova";
    icon: @image-url("../assets/kova_256.png");
    preferred-width: 1040px;
    preferred-height: 680px;
    min-width: 880px;
    min-height: 560px;
    background: Theme.bg;
    default-font-family: "맑은 고딕";
    in property <string> service-status;
    in property <bool> service-ok: true;
    in-out property <string> pick-error;
    in property <string> alert-text;
    in property <[ProfileRow]> profiles;
    in property <[SnapRow]> snapshots;
    in property <[AlertRow]> alerts;
    in property <[string]> setting-lines;
    // 알림 목록이 다시 그려져도 펼친 행을 기억한다
    in-out property <int> open-alert: -1;
    in property <string> log-text;
    callback run-backup(string);
    callback run-verify(string);
    callback run-gc(string);
    callback ack-alerts();
    callback check-update();
    in property <[RunRow]> running;
    callback cancel-job(int);
    callback save-settings(string, bool, bool, bool, bool);
    in-out property <string> form-min-free: "5";
    in-out property <bool> form-ransom: true;
    in-out property <bool> form-encrypt: false;
    in-out property <bool> form-vss: true;
    in-out property <bool> form-pack: false;
    in-out property <string> form-recovery: "";
    callback restore-key(string);
    in property <string> settings-text;
    callback verify-image(string);
    callback restore-image(string, string);
    callback capture-image(string, string);
    callback capture-volume(string);
    callback restore-snapshot(string, string, string);
    callback restore-inplace(string, string);
    callback delete-snapshot(string, string);
    in-out property <string> snap-pending;
    callback open-browse(string, string, string);
    callback browse-go(string);
    callback browse-up();
    callback browse-search(string);
    callback browse-toggle(string);
    callback browse-restore(string);
    in-out property <bool> browse-open: false;
    in property <string> browse-title;
    in property <string> browse-dir;
    in property <string> browse-status;
    in property <int> browse-selected;
    in property <[BrowseRow]> browse-items;
    in property <string> restore-text;
    callback browse(string) -> string;
    callback make-diag();
    in property <string> diag-text;
    callback save-profile(string, string, string, string, string, string, bool, bool, string, string, string, string);
    callback edit-profile(string);
    callback estimate-size(string);
    callback delete-profile(string);
    in-out property <string> form-id;
    in-out property <string> form-name;
    in-out property <string> form-sources;
    in-out property <string> form-repo;
    in-out property <string> form-count: "30";
    in-out property <string> form-days: "60";
    in-out property <bool> form-auto: false;
    in-out property <bool> form-daily: false;
    in-out property <string> form-sched: "12";
    in-out property <string> form-exclude: "";
    in-out property <string> form-weekly: "0";
    in-out property <string> form-monthly: "0";
    in-out property <string> delete-pending;
    in property <string> form-text;
    in property <string> image-text;
    callback install-update();
    in property <string> update-text;
    callback save-offsite(string, string);
    callback run-drill();
    callback export-sysinfo();
    in property <[OffsiteRow]> offsite-rows;
    in-out property <int> page: 0;

    HorizontalLayout {
        // 사이드바
        Rectangle {
            width: 200px;
            background: Theme.side;
            VerticalLayout {
                padding: 14px;
                spacing: 4px;
                Text { text: "Kova"; color: Theme.text; font-size: 24px; font-weight: 800; }
                Text { text: "백업 · 복원 · 무결성"; color: Theme.muted; font-size: 12px; }
                Rectangle { height: 16px; }
                NavItem { text: "홈"; active: root.page == 0; clicked => { root.page = 0; } }
                NavItem { text: "프로파일"; active: root.page == 1; clicked => { root.page = 1; } }
                NavItem { text: "이력 · 복원"; active: root.page == 2; clicked => { root.page = 2; } }
                NavItem { text: "알림"; active: root.page == 3; clicked => { root.page = 3; } }
                NavItem { text: "디스크 이미지"; active: root.page == 4; clicked => { root.page = 4; } }
                NavItem { text: "설정"; active: root.page == 5; clicked => { root.page = 5; } }
                Rectangle { vertical-stretch: 1; }
                Btn { text: Theme.dark ? "밝은 테마" : "어두운 테마"; clicked => { Theme.dark = !Theme.dark; } }
            }
        }

        VerticalLayout {
            padding: 20px;
            spacing: 12px;
            horizontal-stretch: 1;

            // 상단 상태 줄
            HorizontalLayout {
                spacing: 8px;
                height: 28px;
                Text {
                    text: root.page == 0 ? "홈" : root.page == 1 ? "프로파일" : root.page == 2 ? "이력 · 복원" : root.page == 3 ? "알림" : root.page == 4 ? "디스크 이미지" : "설정";
                    color: Theme.text;
                    font-size: 20px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                if root.pick-error != "": Badge { text: root.pick-error; tone: Theme.danger; }
                if root.page != 0: Badge { text: root.service-status; tone: root.service-ok ? Theme.accent : Theme.danger; }
                if root.alert-text != "": Badge { text: root.alert-text; tone: Theme.danger; }
            }

            // 홈
            if root.page == 0: VerticalLayout {
                spacing: 12px;
                HorizontalLayout {
                    spacing: 12px;
                    Stat { label: "서비스"; value: root.service-status; tone: root.service-ok ? Theme.text : Theme.danger; horizontal-stretch: 2; }
                    Stat { label: "프로파일"; value: root.profiles.length + "개"; horizontal-stretch: 1; }
                    Stat { label: "최근 스냅샷"; value: root.snapshots.length > 0 ? root.snapshots[0].when : "없음"; horizontal-stretch: 1; }
                }
                Card {
                    height: 190px;
                    if root.profiles.length == 0: Text {
                        text: "등록된 프로파일이 없습니다. '프로파일' 메뉴에서 추가하세요.";
                        color: Theme.muted;
                        font-size: 13px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    ListView {
                        for p in root.profiles: Rectangle {
                            height: 48px;
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                spacing: 8px;
                                alignment: stretch;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    Text { text: p.name; color: Theme.text; font-size: 14px; font-weight: 600; overflow: elide; }
                                    Text { text: p.last; color: Theme.muted; font-size: 12px; overflow: elide; }
                                }
                                Btn { text: "지금 백업"; kind: 1; y: 8px; clicked => { root.run-backup(p.id); } }
                                Btn { text: "검증"; y: 8px; clicked => { root.run-verify(p.id); } }
                                Btn { text: "정리"; y: 8px; clicked => { root.run-gc(p.id); } }
                            }
                            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
                        }
                    }
                }
                if root.running.length > 0: Card {
                    height: min(root.running.length, 3) * 52px + 8px;
                    ListView {
                        for r in root.running: Rectangle {
                            height: 52px;
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                spacing: 12px;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    spacing: 4px;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text { text: r.name; color: Theme.text; font-size: 14px; font-weight: 600; }
                                        Text { text: r.pct + "%"; color: Theme.accent; font-size: 13px; font-weight: 600; }
                                        Text { text: r.current; color: Theme.muted; font-size: 12px; overflow: elide; horizontal-stretch: 1; }
                                    }
                                    Rectangle {
                                        height: 6px;
                                        border-radius: 3px;
                                        background: Theme.line;
                                        Rectangle { x: 0px; width: parent.width * r.pct / 100; height: parent.height; border-radius: 3px; background: Theme.accent; }
                                    }
                                }
                                if r.cancellable: Btn { text: "취소"; kind: 2; y: 10px; clicked => { root.cancel-job(r.id); } }
                            }
                        }
                    }
                }
                Heading { text: "진행 상황"; }
                Card {
                    vertical-stretch: 1;
                    if root.log-text == "": Text {
                        text: "아직 실행한 작업이 없습니다. 위 목록의 '지금 백업'으로 시작하세요.";
                        color: Theme.muted;
                        font-size: 13px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    ScrollView {
                        Text { x: 14px; y: 12px; width: parent.viewport-width - 28px; text: root.log-text; color: Theme.text; font-size: 13px; wrap: word-wrap; }
                    }
                }
            }

            // 프로파일
            if root.page == 1: VerticalLayout {
                spacing: 12px;
                Card {
                    height: 170px;
                    ListView {
                        for p in root.profiles: Rectangle {
                            height: 52px;
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                spacing: 8px;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    Text { text: p.name; color: Theme.text; font-size: 14px; font-weight: 600; overflow: elide; }
                                    Text { text: p.detail; color: Theme.muted; font-size: 12px; overflow: elide; }
                                }
                                Btn { text: "수정"; y: 10px; clicked => { root.delete-pending = ""; root.edit-profile(p.id); } }
                                Btn {
                                    text: root.delete-pending == p.id ? "정말 삭제" : "삭제";
                                    kind: 2;
                                    y: 10px;
                                    clicked => {
                                        if (root.delete-pending == p.id) {
                                            root.delete-pending = "";
                                            root.delete-profile(p.id);
                                        } else {
                                            root.delete-pending = p.id;
                                        }
                                    }
                                }
                            }
                            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
                        }
                    }
                }
                Card {
                    VerticalLayout {
                        padding: 16px;
                        spacing: 8px;
                        Heading { text: root.form-id == "" ? "새 프로파일 추가" : "프로파일 수정 중"; }
                        Field { text <=> root.form-name; placeholder: "이름"; }
                        PathField { text <=> root.form-sources; placeholder: "백업할 폴더 전체 경로 (여러 개는 ; 로 구분)"; kind: "folders"; append: true; pick(k) => { root.browse(k) } }
                        PathField { text <=> root.form-repo; placeholder: "백업 저장 폴더 전체 경로"; pick(k) => { root.browse(k) } }
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: "자동 백업"; color: Theme.muted; font-size: 13px; vertical-alignment: center; }
                            Btn { text: root.form-auto ? "켜짐" : "꺼짐"; kind: root.form-auto ? 1 : 0; clicked => { root.form-auto = !root.form-auto; } }
                            Btn { text: root.form-daily ? "매일" : "시간 간격"; clicked => { root.form-daily = !root.form-daily; root.form-sched = root.form-daily ? "02:00" : "12"; } }
                            Field { text <=> root.form-sched; width: 80px; }
                            Text { text: root.form-daily ? "시:분에 실행" : "시간마다 실행"; color: Theme.muted; font-size: 13px; vertical-alignment: center; }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        Field { text <=> root.form-exclude; placeholder: "제외할 이름·패턴 (여러 개는 ; 로 구분, 예: *.tmp;node_modules)"; }
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: "보존 개수"; color: Theme.muted; font-size: 13px; vertical-alignment: center; }
                            Field { text <=> root.form-count; width: 80px; }
                            Text { text: "보존 일수"; color: Theme.muted; font-size: 13px; vertical-alignment: center; }
                            Field { text <=> root.form-days; width: 80px; }
                            Text { text: "주간 보관"; color: Theme.muted; font-size: 13px; vertical-alignment: center; }
                            Field { text <=> root.form-weekly; width: 60px; }
                            Text { text: "월간 보관"; color: Theme.muted; font-size: 13px; vertical-alignment: center; }
                            Field { text <=> root.form-monthly; width: 60px; }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Rectangle { horizontal-stretch: 1; }
                            Btn { text: "용량 예측"; clicked => { root.estimate-size(root.form-id); } }
                            Btn { text: "비우기"; clicked => { root.form-id = ""; root.form-name = ""; root.form-sources = ""; root.form-repo = ""; root.form-count = "30"; root.form-days = "60"; root.form-auto = false; root.form-daily = false; root.form-sched = "12"; root.form-exclude = ""; root.form-weekly = "0"; root.form-monthly = "0"; root.delete-pending = ""; } }
                            Btn { text: root.form-id == "" ? "추가" : "저장"; kind: 1; clicked => { root.save-profile(root.form-id, root.form-name, root.form-sources, root.form-repo, root.form-count, root.form-days, root.form-auto, root.form-daily, root.form-sched, root.form-exclude, root.form-weekly, root.form-monthly); } }
                        }
                        Text { text: root.form-text; color: Theme.warn; font-size: 13px; wrap: word-wrap; }
                        Hint { text: "삭제는 프로파일 설정만 지우며 저장소의 백업 파일은 그대로 둡니다. 새 프로파일은 자동 백업이 꺼진 채로 시작합니다. 자동 백업은 서비스가 켜져 있어야 동작합니다."; }
                        Rectangle { vertical-stretch: 1; }
                    }
                }
            }

            // 이력 · 복원
            if root.page == 2: VerticalLayout {
                spacing: 12px;
                Card {
                    height: 132px;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 8px;
                        Heading { text: "복원 위치"; }
                        rt := PathField { placeholder: "복원할 새 폴더 전체 경로 (예: D 드라이브의 새 폴더)"; pick(k) => { root.browse(k) } }
                        Hint { text: "전체 복원은 새 폴더(또는 빈 폴더)로 복원해 원래 위치를 덮어쓰지 않습니다. \"원래 위치로\"는 두 번 눌러야 하며 같은 이름의 파일을 덮어씁니다. 삭제도 두 번 눌러야 하고 되돌릴 수 없습니다."; }
                    }
                }
                if root.browse-open: VerticalLayout {
                    spacing: 8px;
                    vertical-stretch: 1;
                    HorizontalLayout {
                        spacing: 8px;
                        Btn { text: "← 목록"; clicked => { root.browse-open = false; } }
                        Btn { text: "상위 폴더"; clicked => { root.browse-up(); } }
                        Text { text: root.browse-title + "  " + root.browse-dir; color: Theme.text; font-size: 13px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                        bq := Field { placeholder: "파일 이름 검색"; width: 180px; }
                        Btn { text: "검색"; clicked => { root.browse-search(bq.text); } }
                    }
                    Card {
                        vertical-stretch: 1;
                        ListView {
                            for it in root.browse-items: Rectangle {
                                height: 36px;
                                HorizontalLayout {
                                    padding-left: 14px;
                                    padding-right: 14px;
                                    spacing: 10px;
                                    Rectangle {
                                        width: 18px;
                                        height: 18px;
                                        y: 9px;
                                        border-radius: 4px;
                                        border-width: 1px;
                                        border-color: it.selected ? Theme.accent : Theme.line;
                                        background: it.selected ? Theme.accent : transparent;
                                        Text { text: it.selected ? "✓" : ""; color: #ffffff; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                                        TouchArea { clicked => { root.browse-toggle(it.path); } }
                                    }
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        Text { text: it.name; color: it.is-dir ? Theme.accent : Theme.text; font-size: 13px; font-weight: it.is-dir ? 600 : 400; vertical-alignment: center; overflow: elide; width: parent.width; }
                                        TouchArea { clicked => { if (it.is-dir) { root.browse-go(it.path); } else { root.browse-toggle(it.path); } } }
                                    }
                                    Text { text: it.info; color: Theme.muted; font-size: 12px; width: 150px; horizontal-alignment: right; vertical-alignment: center; }
                                }
                                Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: root.browse-status != "" ? root.browse-status : "폴더를 누르면 안으로 들어가고, 체크한 항목만 복원합니다"; color: Theme.muted; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                        Text { text: root.browse-selected + "개 선택"; color: Theme.text; font-size: 13px; vertical-alignment: center; }
                        Btn { text: "선택 항목 복원"; kind: 1; clicked => { root.browse-restore(rt.text); } }
                    }
                }
                if !root.browse-open: Card {
                    vertical-stretch: 1;
                    ListView {
                        for s in root.snapshots: Rectangle {
                            height: 44px;
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                spacing: 8px;
                                Text { text: s.when; color: Theme.text; width: 84px; font-size: 13px; vertical-alignment: center; }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    Text { text: s.name; color: Theme.text; font-size: 13px; overflow: elide; }
                                    Text { text: s.summary; color: Theme.muted; font-size: 12px; overflow: elide; }
                                }
                                Text { text: s.verified; color: s.verified == "미검증" || s.verified == "" ? Theme.muted : Theme.ok; font-size: 12px; width: 64px; vertical-alignment: center; }
                                Btn { text: "파일 보기"; y: 6px; clicked => { root.browse-open = true; root.open-browse(s.repo, s.id, s.when); } }
                                Btn { text: "전체 복원"; kind: 0; y: 6px; clicked => { root.snap-pending = ""; root.restore-snapshot(s.repo, s.id, rt.text); } }
                                Btn {
                                    text: root.snap-pending == "R" + s.id ? "정말 덮어쓰기" : "원래 위치로";
                                    kind: 2;
                                    y: 6px;
                                    clicked => {
                                        if (root.snap-pending == "R" + s.id) {
                                            root.snap-pending = "";
                                            root.restore-inplace(s.repo, s.id);
                                        } else {
                                            root.snap-pending = "R" + s.id;
                                        }
                                    }
                                }
                                Btn {
                                    text: root.snap-pending == "D" + s.id ? "정말 삭제" : "삭제";
                                    kind: 2;
                                    y: 6px;
                                    clicked => {
                                        if (root.snap-pending == "D" + s.id) {
                                            root.snap-pending = "";
                                            root.delete-snapshot(s.repo, s.id);
                                        } else {
                                            root.snap-pending = "D" + s.id;
                                        }
                                    }
                                }
                            }
                            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
                        }
                    }
                }
                Text { text: root.restore-text; color: Theme.warn; font-size: 13px; wrap: word-wrap; }
            }

            // 알림
            if root.page == 3: VerticalLayout {
                spacing: 12px;
                HorizontalLayout {
                    Rectangle { horizontal-stretch: 1; }
                    Btn { text: "모두 확인"; kind: 1; clicked => { root.ack-alerts(); } }
                }
                Card {
                    vertical-stretch: 1;
                    ListView {
                        for a[i] in root.alerts: Rectangle {
                            min-height: 44px;
                            HorizontalLayout {
                                padding: 12px;
                                spacing: 12px;
                                Text { text: a.when; color: Theme.muted; width: 110px; font-size: 12px; vertical-alignment: top; }
                                Badge { text: a.level; tone: a.level == "error" ? Theme.danger : Theme.warn; y: 0px; }
                                Text { text: root.open-alert == i ? a.full : a.message; color: Theme.text; font-size: 13px; font-weight: a.ack ? 400 : 700; horizontal-stretch: 1; wrap: word-wrap; }
                            }
                            TouchArea { clicked => { root.open-alert = root.open-alert == i ? -1 : i; } }
                            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
                        }
                    }
                }
            }

            // 디스크 이미지
            if root.page == 4: ScrollView {
                VerticalLayout {
                    spacing: 12px;
                    Card {
                        height: 178px;
                        VerticalLayout {
                            padding: 16px;
                            spacing: 8px;
                            Heading { text: "이미지(.qblk) 검증 · 복원"; }
                            Hint { text: "복원은 새 파일(.img/.raw/.vhd/.vhdx/.bin)로만 풉니다. 실제 디스크·드라이브로는 복원되지 않습니다."; }
                            img := PathField { placeholder: "이미지 파일(.qblk) 경로"; kind: "qblk-open"; pick(k) => { root.browse(k) } }
                            out := PathField { placeholder: "복원할 새 파일 경로 (예: 새 폴더의 restored.img)"; kind: "img-save"; pick(k) => { root.browse(k) } }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;
                        Btn { text: "검증만"; clicked => { root.verify-image(img.text); } }
                        Btn { text: "복원"; kind: 2; clicked => { root.restore-image(img.text, out.text); } }
                    }
                    Card {
                        height: 150px;
                        VerticalLayout {
                            padding: 16px;
                            spacing: 8px;
                            Heading { text: "디스크 이미지 파일 → .qblk"; }
                            Hint { text: ".img/.raw/.bin/.vhd 를 .qblk 로 만듭니다. 원본은 읽기만 합니다."; }
                            csrc := PathField { placeholder: "원본 이미지 파일 경로"; kind: "img-open"; pick(k) => { root.browse(k) } }
                            cout := PathField { placeholder: "만들 .qblk 파일 전체 경로 (새 파일)"; kind: "qblk-save"; pick(k) => { root.browse(k) } }
                        }
                    }
                    HorizontalLayout {
                        alignment: end;
                        Btn { text: "이미지 만들기"; kind: 1; clicked => { root.capture-image(csrc.text, cout.text); } }
                    }
                    Card {
                        height: 120px;
                        VerticalLayout {
                            padding: 16px;
                            spacing: 8px;
                            Heading { text: "내장 드라이브 볼륨 이미지"; }
                            Hint { text: "서비스가 섀도 복사본으로 읽기 전용 이미지를 만듭니다. 저장 위치: 첫 프로파일 저장 폴더 안 images 폴더."; }
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                cvol := Field { placeholder: "드라이브 문자 (예: F)"; width: 200px; }
                                Btn { text: "볼륨 이미지 만들기"; kind: 1; clicked => { root.capture-volume(cvol.text); } }
                            }
                        }
                    }
                    Text { text: root.image-text; color: Theme.warn; font-size: 13px; wrap: word-wrap; }
                }
            }

            // 설정
            if root.page == 5: ScrollView {
                viewport-width: self.visible-width;
                VerticalLayout {
                    spacing: 12px;
                    alignment: start;
                    Card {
                        VerticalLayout {
                            alignment: start;
                            padding: 16px;
                            spacing: 6px;
                            Heading { text: "현재 설정"; }
                            for l in root.setting-lines: Text { text: l; color: l == "프로파일" ? Theme.text : Theme.muted; font-size: 13px; font-weight: l == "프로파일" ? 700 : 400; wrap: word-wrap; }
                        }
                    }
                    Card {
                        VerticalLayout {
                            alignment: start;
                            padding: 16px;
                            spacing: 10px;
                            Heading { text: "설정 변경"; }
                            HorizontalLayout {
                                spacing: 8px;
                                Text { text: "최소 여유 공간(GB)"; color: Theme.text; font-size: 13px; width: 150px; vertical-alignment: center; }
                                Field { text <=> root.form-min-free; width: 80px; }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                Text { text: "랜섬웨어 보호"; color: Theme.text; font-size: 13px; width: 150px; vertical-alignment: center; }
                                Btn { text: root.form-ransom ? "켜짐" : "꺼짐"; kind: root.form-ransom ? 1 : 0; clicked => { root.form-ransom = !root.form-ransom; } }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            Hint { text: "켜면 백업으로 생긴 파일을 읽기 전용으로 잠가 덮어쓰기·실수로 지우는 것을 막습니다. 관리자 권한의 의도적인 삭제까지 막지는 못합니다."; }
                            HorizontalLayout {
                                spacing: 8px;
                                Text { text: "백업 암호화"; color: Theme.text; font-size: 13px; width: 150px; vertical-alignment: center; }
                                Btn { text: root.form-encrypt ? "켜짐" : "꺼짐"; kind: root.form-encrypt ? 1 : 0; clicked => { root.form-encrypt = !root.form-encrypt; } }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            Hint { text: "켜고 저장하면 각 프로파일 저장소가 암호화되고, 그 뒤 새로 저장되는 데이터가 암호화됩니다(이미 있던 백업은 그대로). 저장 직후 한 번만 보이는 복구 코드를 반드시 따로 보관하세요. 코드가 없으면 이 PC가 고장 났을 때 백업을 열 수 없습니다."; }
                            HorizontalLayout {
                                spacing: 8px;
                                Text { text: "잠긴 파일 백업(VSS)"; color: Theme.text; font-size: 13px; width: 150px; vertical-alignment: center; }
                                Btn { text: root.form-vss ? "켜짐" : "꺼짐"; kind: root.form-vss ? 1 : 0; clicked => { root.form-vss = !root.form-vss; } }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            Hint { text: "백업 직전에 원본 드라이브의 스냅샷을 떠서, 다른 프로그램이 열어 둔 파일도 같은 시점으로 백업합니다. 만들 수 없으면 직접 읽습니다."; }
                            HorizontalLayout {
                                spacing: 8px;
                                Text { text: "블롭 팩으로 묶기"; color: Theme.text; font-size: 13px; width: 150px; vertical-alignment: center; }
                                Btn { text: root.form-pack ? "켜짐" : "꺼짐"; kind: root.form-pack ? 1 : 0; clicked => { root.form-pack = !root.form-pack; } }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            Hint { text: "백업 뒤 오래된 작은 파일들을 큰 파일 몇 개로 묶어 저장소의 파일 수를 줄입니다(복사·오프사이트가 빨라집니다). 묶기 전에 다시 읽어 확인합니다. 팩을 모르는 이전 Kova2 버전으로는 이렇게 묶은 저장소를 읽지 못합니다."; }
                            HorizontalLayout {
                                spacing: 8px;
                                Text { text: "복구 코드로 키 복원"; color: Theme.text; font-size: 13px; width: 150px; vertical-alignment: center; }
                                Field { text <=> root.form-recovery; horizontal-stretch: 1; }
                                Btn { text: "복원"; clicked => { root.restore-key(root.form-recovery); } }
                            }
                            Hint { text: "PC를 바꾸거나 키 파일을 잃었을 때, 암호화를 켤 때 받은 복구 코드를 붙여 넣고 누릅니다."; }
                            HorizontalLayout {
                                spacing: 8px;
                                Btn { text: "설정 저장"; kind: 1; clicked => { root.save-settings(root.form-min-free, root.form-ransom, root.form-encrypt, root.form-vss, root.form-pack); } }
                                if root.settings-text != "": Text { text: root.settings-text; color: Theme.muted; font-size: 13px; vertical-alignment: center; wrap: word-wrap; horizontal-stretch: 1; }
                                if root.settings-text == "": Rectangle { horizontal-stretch: 1; }
                            }
                        }
                    }
                    Card {
                        VerticalLayout {
                            alignment: start;
                            padding: 16px;
                            spacing: 10px;
                            Heading { text: "업데이트 · 진단"; }
                            HorizontalLayout {
                                spacing: 8px;
                                Btn { text: "업데이트 확인"; clicked => { root.check-update(); } }
                                Btn { text: "업데이트 설치"; kind: 1; clicked => { root.install-update(); } }
                                Btn { text: "복구 훈련"; clicked => { root.run-drill(); } }
                                Btn { text: "시스템 정보 내보내기"; clicked => { root.export-sysinfo(); } }
                                Btn { text: "진단 파일 만들기"; clicked => { root.make-diag(); } }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            if root.update-text != "": Text { text: root.update-text; color: Theme.muted; font-size: 13px; wrap: word-wrap; }
                            if root.diag-text != "": Text { text: root.diag-text; color: Theme.muted; font-size: 13px; wrap: word-wrap; }
                        }
                    }
                    Card {
                        VerticalLayout {
                            alignment: start;
                            padding: 16px;
                            spacing: 8px;
                            Heading { text: "오프사이트 폴더"; }
                            Hint { text: "프로파일별 복제 위치입니다. 비우면 복제하지 않습니다."; }
                            for o in root.offsite-rows: HorizontalLayout {
                                spacing: 8px;
                                Text { text: o.name; color: Theme.text; font-size: 13px; width: 190px; vertical-alignment: center; wrap: word-wrap; }
                                le := PathField { text: o.dir; placeholder: "네트워크 경로나 다른 드라이브의 폴더"; horizontal-stretch: 1; pick(k) => { root.browse(k) } }
                                Btn { text: "저장"; kind: 1; clicked => { root.save-offsite(o.id, le.text); } }
                            }
                        }
                    }
                }
            }
        }
    }
}
