import { Button, ListView, TabWidget, LineEdit } from "std-widgets.slint";

export struct ProfileRow { id: string, name: string, last: string, detail: string }
export struct SnapRow { id: string, repo: string, when: string, summary: string, verified: string }
export struct OffsiteRow { id: string, name: string, dir: string }
export struct AlertRow { when: string, level: string, message: string, ack: bool }

export component MainWindow inherits Window {
    title: "Kova";
    preferred-width: 800px;
    preferred-height: 560px;
    default-font-family: "맑은 고딕";
    in property <string> service-status;
    in property <string> alert-text;
    in property <[ProfileRow]> profiles;
    in property <[SnapRow]> snapshots;
    in property <[AlertRow]> alerts;
    in property <[string]> setting-lines;
    in property <string> log-text;
    callback run-backup(string);
    callback run-verify(string);
    callback run-gc(string);
    callback ack-alerts();
    callback check-update();
    callback verify-image(string);
    callback restore-image(string, string);
    callback capture-image(string, string);
    callback capture-volume(string);
    callback restore-snapshot(string, string, string);
    in property <string> restore-text;
    callback make-diag();
    in property <string> diag-text;
    callback save-profile(string, string, string, string, string, string);
    callback edit-profile(string);
    callback delete-profile(string);
    in-out property <string> form-id;
    in-out property <string> form-name;
    in-out property <string> form-sources;
    in-out property <string> form-repo;
    in-out property <string> form-count: "30";
    in-out property <string> form-days: "60";
    in-out property <string> delete-pending;
    in property <string> form-text;
    in property <string> image-text;
    callback install-update();
    in property <string> update-text;
    callback save-offsite(string, string);
    in property <[OffsiteRow]> offsite-rows;
    VerticalLayout {
        padding: 16px;
        spacing: 8px;
        Text { text: "Kova 백업"; font-size: 22px; font-weight: 700; }
        Text { text: root.service-status; font-size: 14px; }
        Text { text: root.alert-text; font-size: 14px; color: #c0392b; }
        TabWidget {
            Tab {
                title: "홈";
                VerticalLayout {
                    spacing: 8px;
                    ListView {
                        height: 200px;
                        for p in root.profiles: HorizontalLayout {
                            spacing: 8px;
                            padding: 4px;
                            Text { text: p.name + "  (" + p.last + ")"; vertical-alignment: center; horizontal-stretch: 1; }
                            Button { text: "지금 백업"; clicked => { root.run-backup(p.id); } }
                            Button { text: "검증"; clicked => { root.run-verify(p.id); } }
                            Button { text: "정리"; clicked => { root.run-gc(p.id); } }
                        }
                    }
                    Text { text: "진행 상황"; font-size: 16px; font-weight: 600; }
                    Text { text: root.log-text; wrap: word-wrap; vertical-stretch: 1; }
                }
            }
            Tab {
                title: "프로파일";
                VerticalLayout {
                    spacing: 6px;
                    ListView {
                        height: 130px;
                        for p in root.profiles: HorizontalLayout {
                            spacing: 8px;
                            padding: 3px;
                            Text { text: p.name + " — " + p.detail; vertical-alignment: center; horizontal-stretch: 1; wrap: word-wrap; }
                            Button { text: "수정"; clicked => { root.delete-pending = ""; root.edit-profile(p.id); } }
                            Button {
                                text: root.delete-pending == p.id ? "정말 삭제" : "삭제";
                                clicked => {
                                    if (root.delete-pending == p.id) {
                                        root.delete-pending = "";
                                        root.delete-profile(p.id);
                                    } else {
                                        root.delete-pending = p.id;
                                    }
                                }
                            }
                        }
                    }
                    Text { text: root.form-id == "" ? "새 프로파일 추가" : "프로파일 수정 중"; font-weight: 600; }
                    LineEdit { text <=> root.form-name; placeholder-text: "이름"; }
                    LineEdit { text <=> root.form-sources; placeholder-text: "백업할 폴더 전체 경로 (여러 개는 ; 로 구분)"; }
                    LineEdit { text <=> root.form-repo; placeholder-text: "백업 저장 폴더 전체 경로"; }
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "보존 개수"; vertical-alignment: center; }
                        LineEdit { text <=> root.form-count; width: 70px; }
                        Text { text: "보존 일수"; vertical-alignment: center; }
                        LineEdit { text <=> root.form-days; width: 70px; }
                        Button { text: root.form-id == "" ? "추가" : "저장"; clicked => { root.save-profile(root.form-id, root.form-name, root.form-sources, root.form-repo, root.form-count, root.form-days); } }
                        Button { text: "비우기"; clicked => { root.form-id = ""; root.form-name = ""; root.form-sources = ""; root.form-repo = ""; root.form-count = "30"; root.form-days = "60"; root.delete-pending = ""; } }
                    }
                    Text { text: root.form-text; wrap: word-wrap; }
                    Text { text: "삭제는 프로파일 설정만 지우며 저장소의 백업 파일은 그대로 둡니다. 새 프로파일은 자동 백업이 꺼진 채로 시작합니다."; wrap: word-wrap; color: #777777; }
                }
            }
            Tab {
                title: "이력";
                VerticalLayout {
                    spacing: 6px;
                    Text { text: "스냅샷을 새 폴더(또는 빈 폴더)로 복원합니다. 원래 위치를 덮어쓰지 않습니다."; wrap: word-wrap; }
                    rt := LineEdit { placeholder-text: "복원할 새 폴더 전체 경로 (예: D 드라이브의 새 폴더)"; }
                    ListView {
                        for s in root.snapshots: HorizontalLayout {
                            spacing: 10px;
                            padding: 3px;
                            Text { text: s.when; width: 120px; vertical-alignment: center; }
                            Text { text: s.summary; horizontal-stretch: 1; vertical-alignment: center; }
                            Text { text: s.verified; width: 70px; vertical-alignment: center; }
                            Button { text: "복원"; clicked => { root.restore-snapshot(s.repo, s.id, rt.text); } }
                        }
                    }
                    Text { text: root.restore-text; wrap: word-wrap; }
                }
            }
            Tab {
                title: "알림";
                VerticalLayout {
                    spacing: 6px;
                    Button { text: "모두 확인"; clicked => { root.ack-alerts(); } }
                    ListView {
                        for a in root.alerts: HorizontalLayout {
                            spacing: 10px;
                            padding: 3px;
                            Text { text: a.when; width: 100px; }
                            Text { text: a.level; width: 50px; color: a.level == "error" ? #c0392b : #b9770e; }
                            Text { text: a.message; horizontal-stretch: 1; wrap: word-wrap; font-weight: a.ack ? 400 : 700; }
                        }
                    }
                }
            }
            Tab {
                title: "이미지";
                VerticalLayout {
                    spacing: 8px;
                    Text { text: "디스크 이미지(.qblk) 검증·복원"; font-weight: 600; }
                    Text { text: "복원은 새 파일(.img/.raw/.vhd/.vhdx/.bin)로만 풉니다. 실제 디스크·드라이브로는 복원되지 않습니다."; wrap: word-wrap; }
                    img := LineEdit { placeholder-text: "이미지 파일(.qblk) 경로"; }
                    out := LineEdit { placeholder-text: "복원할 새 파일 경로 (예: 새 폴더의 restored.img)"; }
                    HorizontalLayout {
                        spacing: 8px;
                        Button { text: "검증만"; clicked => { root.verify-image(img.text); } }
                        Button { text: "복원"; clicked => { root.restore-image(img.text, out.text); } }
                    }
                    Text { text: "디스크 이미지 파일(.img/.raw/.bin/.vhd)을 .qblk 로 만들기 (원본은 읽기만 합니다)"; font-weight: 600; wrap: word-wrap; }
                    csrc := LineEdit { placeholder-text: "원본 이미지 파일 경로"; }
                    cout := LineEdit { placeholder-text: "만들 .qblk 파일 전체 경로 (새 파일)"; }
                    Button { text: "이미지 만들기"; clicked => { root.capture-image(csrc.text, cout.text); } }
                    Text { text: "내장 드라이브를 서비스가 섀도 복사본으로 이미지 만들기 (읽기 전용, 저장 위치: 첫 프로파일 저장 폴더 안 images 폴더)"; font-weight: 600; wrap: word-wrap; }
                    HorizontalLayout {
                        spacing: 8px;
                        cvol := LineEdit { placeholder-text: "드라이브 문자 (예: F)"; width: 160px; }
                        Button { text: "볼륨 이미지 만들기"; clicked => { root.capture-volume(cvol.text); } }
                    }
                    Text { text: root.image-text; wrap: word-wrap; vertical-stretch: 1; }
                }
            }
            Tab {
                title: "설정";
                VerticalLayout {
                    spacing: 6px;
                    ListView {
                        for l in root.setting-lines: Text { text: l; wrap: word-wrap; }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Button { text: "업데이트 확인"; clicked => { root.check-update(); } }
                        Button { text: "업데이트 설치"; clicked => { root.install-update(); } }
                        Text { text: root.update-text; vertical-alignment: center; }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Button { text: "진단 파일 만들기"; clicked => { root.make-diag(); } }
                        Text { text: root.diag-text; vertical-alignment: center; wrap: word-wrap; horizontal-stretch: 1; }
                    }
                    Text { text: "프로파일별 오프사이트 폴더(비우면 복제 안 함)"; font-weight: 600; }
                    ListView {
                        height: 130px;
                        for o in root.offsite-rows: HorizontalLayout {
                            spacing: 8px;
                            Text { text: o.name; width: 140px; vertical-alignment: center; }
                            le := LineEdit { text: o.dir; placeholder-text: "네트워크 경로나 다른 드라이브의 폴더"; horizontal-stretch: 1; }
                            Button { text: "저장"; clicked => { root.save-offsite(o.id, le.text); } }
                        }
                    }
                }
            }
        }
    }
}
