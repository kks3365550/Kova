import { ListView, ScrollView } from "std-widgets.slint";

export struct ProfileRow { id: string, name: string, last: string, detail: string, next: string, stale: bool, size: string }
export struct ProgPick { name: string, sub: string, checked: bool }
export struct SrcRow { kind: int, title: string, sub: string, key: string }
export struct SnapRow { id: string, profile-id: string, repo: string, when: string, name: string, summary: string, verified: string }
export struct OffsiteRow { id: string, name: string, dir: string }
export struct AlertRow { when: string, level: string, message: string, full: string, ack: bool }
export struct BrowseRow { name: string, path: string, is-dir: bool, info: string, selected: bool }
export struct DriveRow { name: string, pct: int, used: string, free: string, repo: bool }
export struct ImageRow { name: string, path: string, size: string, when: string }
export struct RunRow { id: int, name: string, pct: int, current: string, cancellable: bool, kind: string }
export struct GlobalFileRow { filename: string, rel-path: string, repo: string, snapshot-id: string, versions: string, info: string }
// '찾아보기' 결과 전달: 선택 창은 별도 스레드에서 열고, 끝나면 앱이 target 이 같은 PathField 에 값을 넣는다(seq 증가로 알림).
export global PickBus {
    in-out property <int> seq;
    in-out property <string> target;
    in-out property <string> value;
}

global Theme {
    in-out property <bool> dark: true;
    
    // Windows 11 Fluent Mica / Slate canvas
    out property <color> bg: dark ? #0b0f17 : #f8fafc;
    out property <color> bg-subtle: dark ? #111722 : #f1f5f9;
    
    // Frosted surfaces & Sidebars
    out property <color> side: dark ? #0f1520 : #ffffff;
    
    // Acrylic Elevated Cards
    out property <color> card: dark ? #161e2b : #ffffff;
    out property <color> card-hi: dark ? #1e2838 : #f8fafc;
    out property <color> card-pressed: dark ? #121924 : #edf2f7;
    
    // Refined micro-borders
    out property <color> line: dark ? #ffffff14 : #e2e8f0;
    out property <color> line-focus: dark ? #3b82f6 : #2563eb;
    
    // Typography hierarchy (WCAG AAA compliant)
    out property <color> text: dark ? #f8fafc : #0f172a;
    out property <color> text-sub: dark ? #cbd5e1 : #334155;
    out property <color> muted: dark ? #94a3b8 : #64748b;
    
    // Vibrant & accessible semantic accents
    out property <color> accent: dark ? #3b82f6 : #2563eb;
    out property <color> accent-hi: dark ? #60a5fa : #1d4ed8;
    out property <color> accent-bg: dark ? #3b82f61a : #eff6ff;
    
    out property <color> ok: #22c55e;
    out property <color> ok-bg: dark ? #22c55e1a : #f0fdf4;
    
    out property <color> warn: #eab308;
    out property <color> warn-bg: dark ? #eab3081a : #fefce8;
    
    out property <color> danger: #ef4444;
    out property <color> danger-bg: dark ? #ef44441a : #fef2f2;
}


component Card inherits Rectangle {
    background: Theme.card;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.line;
}

component Heading inherits Text {
    color: Theme.text;
    font-size: 15px;
    font-weight: 700;
}

component Hint inherits Text {
    color: Theme.muted;
    font-size: 12px;
    wrap: word-wrap;
}

// Fluent Button with 3 tactile variants (0: standard subtle, 1: primary accent, 2: danger)
component Btn inherits Rectangle {
    in property <string> text;
    in property <int> kind: 0;
    callback clicked();
    min-width: lbl.preferred-width + 24px;
    height: 32px;
    border-radius: 8px;
    border-width: 1px;
    
    background: kind == 1 
        ? (ta.has-hover ? (ta.pressed ? Theme.accent : Theme.accent-hi) : Theme.accent)
        : kind == 2 
            ? (ta.has-hover ? (ta.pressed ? #dc2626 : Theme.danger) : Theme.danger-bg)
            : (ta.has-hover ? (ta.pressed ? Theme.card-pressed : Theme.card-hi) : Theme.card);
            
    border-color: kind == 1 
        ? Theme.accent 
        : kind == 2 
            ? (ta.has-hover ? Theme.danger : Theme.danger.with-alpha(0.4)) 
            : (ta.has-hover ? Theme.line-focus : Theme.line);
            
    lbl := Text {
        text: root.text;
        color: kind == 1 
            ? #ffffff 
            : kind == 2 
                ? (ta.has-hover ? #ffffff : Theme.danger) 
                : (ta.has-hover ? Theme.text : Theme.text-sub);
        font-size: 13px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

component Field inherits Rectangle {
    in-out property <string> text <=> ti.text;
    in property <string> placeholder;
    in property <bool> secret: false;
    height: 36px;
    border-radius: 8px;
    border-width: 1px;
    border-color: ti.has-focus ? Theme.line-focus : Theme.line;
    background: Theme.bg-subtle;
    
    Text {
        x: 12px;
        text: root.placeholder;
        color: Theme.muted;
        font-size: 13px;
        vertical-alignment: center;
        visible: ti.text == "";
    }
    ti := TextInput {
        x: 12px;
        width: parent.width - 24px;
        height: parent.height;
        font-size: 13px;
        color: Theme.text;
        vertical-alignment: center;
        single-line: true;
        input-type: root.secret ? InputType.password : InputType.text;
    }
}

component PathField inherits HorizontalLayout {
    in-out property <string> text <=> f.text;
    in property <string> placeholder;
    in property <string> kind: "folder";
    in property <bool> append: false;
    in property <string> target;
    callback pick(string, string);
    property <int> bus-seq: PickBus.seq;
    changed bus-seq => {
        if (root.target != "" && PickBus.target == root.target) {
            f.text = (root.append && f.text != "") ? f.text + ";" + PickBus.value : PickBus.value;
        }
    }
    spacing: 8px;
    f := Field { placeholder: root.placeholder; horizontal-stretch: 1; }
    Btn {
        text: "찾아보기";
        clicked => { root.pick(root.kind, root.target); }
    }
}

component Badge inherits Rectangle {
    in property <string> text;
    in property <color> tone: Theme.muted;
    height: 24px;
    border-radius: 12px;
    background: tone.with-alpha(0.16);
    border-width: 1px;
    border-color: tone.with-alpha(0.3);
    horizontal-stretch: 0;
    width: bl.preferred-width + 28px;
    
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 6px;
        alignment: center;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 6px;
                height: 6px;
                border-radius: 3px;
                background: root.tone;
            }
        }
        bl := Text {
            text: root.text;
            color: root.tone;
            font-size: 11px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

component Meter inherits Rectangle {
    in property <int> pct;
    in property <color> tone: Theme.accent;
    height: 8px;
    border-radius: 4px;
    background: Theme.bg-subtle;
    border-width: 1px;
    border-color: Theme.line;
    Rectangle {
        x: 0px;
        width: parent.width * min(root.pct, 100) / 100;
        height: parent.height;
        border-radius: 4px;
        background: root.tone;
    }
}

// Windows 11 Fluent Stepper Nav Item (Tiny11 Style)
component NavStepItem inherits Rectangle {
    in property <string> step-num;
    in property <string> title;
    in property <string> sub;
    in property <bool> active;
    callback clicked();
    
    height: 60px;
    border-radius: 10px;
    background: active ? (Theme.dark ? #ffffff14 : #eff6ff) : (ta.has-hover ? (Theme.dark ? #ffffff0a : #f1f5f9) : transparent);
    border-width: 1px;
    border-color: active ? (Theme.dark ? #3b82f688 : #93c5fd) : transparent;
    
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;
        alignment: stretch;
        
        Rectangle {
            width: 32px;
            height: 32px;
            border-radius: 16px;
            background: active ? Theme.accent : (Theme.dark ? #ffffff18 : #e2e8f0);
            
            Text {
                text: root.step-num;
                color: active ? #ffffff : Theme.muted;
                font-size: 14px;
                font-weight: 800;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            
            Text {
                text: root.title;
                color: active ? Theme.text : Theme.text-sub;
                font-size: 13px;
                font-weight: active ? 700 : 600;
                overflow: elide;
            }
            Text {
                text: root.sub;
                color: Theme.muted;
                font-size: 11px;
                overflow: elide;
            }
        }
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

// 3 Big Backup Mode Cards for Page 0 (Tiny11 Builder Style)
component ModeCard inherits Rectangle {
    in property <string> badge-text;
    in property <string> title;
    in property <string> desc;
    in property <string> tag;
    in property <string> icon-text;
    in property <string> f1: "";
    in property <string> f2: "";
    in property <string> f3: "";
    in property <bool> selected: false;
    callback clicked();
    
    min-height: 290px;
    border-radius: 14px;
    background: selected ? (Theme.dark ? #1a2333 : #f0f7ff) : (ta.has-hover ? (Theme.dark ? #1a2230 : #f8fafc) : Theme.card);
    border-width: selected ? 2px : 1px;
    border-color: selected ? Theme.accent : (ta.has-hover ? Theme.line-focus : Theme.line);
    
    animate background { duration: 120ms; }
    animate border-color { duration: 120ms; }
    
    VerticalLayout {
        padding: 22px;
        spacing: 12px;
        
        HorizontalLayout {
            alignment: space-between;
            
            // Icon Container
            Rectangle {
                width: 44px;
                height: 44px;
                border-radius: 11px;
                background: selected ? Theme.accent.with-alpha(0.2) : (Theme.dark ? #222c3d : #f1f5f9);
                border-width: 1px;
                border-color: selected ? Theme.accent.with-alpha(0.4) : Theme.line;
                
                Text {
                    text: root.icon-text;
                    font-size: 22px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            
            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                
                if root.badge-text != "": Badge {
                    text: root.badge-text;
                    tone: selected ? Theme.accent : Theme.muted;
                }
                
                // Radio indicator (Fluent UI style)
                Rectangle {
                    width: 20px;
                    height: 20px;
                    y: 2px;
                    border-radius: 10px;
                    border-width: 2px;
                    border-color: selected ? Theme.accent : (Theme.dark ? #334155 : #cbd5e1);
                    background: transparent;
                    
                    if selected: Rectangle {
                        width: 10px;
                        height: 10px;
                        border-radius: 5px;
                        background: Theme.accent;
                    }
                }
            }
        }
        
        // Mode Title
        Text {
            height: 24px;
            text: root.title;
            color: selected ? (Theme.dark ? #ffffff : #0f172a) : Theme.text;
            font-size: 18px;
            font-weight: 800;
            vertical-alignment: center;
        }
        
        // Mode Description
        Text {
            height: 56px;
            text: root.desc;
            color: selected ? (Theme.dark ? #cbd5e1 : #475569) : Theme.muted;
            font-size: 13px;
            wrap: word-wrap;
        }
        
        Rectangle {
            height: 1px;
            background: selected ? Theme.accent.with-alpha(0.25) : Theme.line;
        }
        
        // Feature bullet points
        if root.f1 != "": VerticalLayout {
            spacing: 8px;
            HorizontalLayout {
                height: 20px;
                spacing: 8px;
                alignment: start;
                VerticalLayout {
                    alignment: center;
                    Rectangle { width: 5px; height: 5px; border-radius: 2.5px; background: selected ? Theme.accent : Theme.muted; }
                }
                Text { text: root.f1; color: selected ? Theme.text : Theme.text-sub; font-size: 12px; vertical-alignment: center; }
            }
            if root.f2 != "": HorizontalLayout {
                height: 20px;
                spacing: 8px;
                alignment: start;
                VerticalLayout {
                    alignment: center;
                    Rectangle { width: 5px; height: 5px; border-radius: 2.5px; background: selected ? Theme.accent : Theme.muted; }
                }
                Text { text: root.f2; color: selected ? Theme.text : Theme.text-sub; font-size: 12px; vertical-alignment: center; }
            }
            if root.f3 != "": HorizontalLayout {
                height: 20px;
                spacing: 8px;
                alignment: start;
                VerticalLayout {
                    alignment: center;
                    Rectangle { width: 5px; height: 5px; border-radius: 2.5px; background: selected ? Theme.accent : Theme.muted; }
                }
                Text { text: root.f3; color: selected ? Theme.text : Theme.text-sub; font-size: 12px; vertical-alignment: center; }
            }
        }
        
        Rectangle { vertical-stretch: 1; }
        
        // Tag Pill / Footer
        if root.tag != "": HorizontalLayout {
            alignment: start;
            Rectangle {
                border-radius: 6px;
                background: selected ? Theme.accent.with-alpha(0.12) : (Theme.dark ? #1a2230 : #f1f5f9);
                border-width: 1px;
                border-color: selected ? Theme.accent.with-alpha(0.3) : transparent;
                
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    padding-top: 5px;
                    padding-bottom: 5px;
                    
                    Text {
                        text: root.tag;
                        color: selected ? Theme.accent : Theme.muted;
                        font-size: 11px;
                        font-weight: 700;
                    }
                }
            }
        }
    }
    
    ta := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
}
export component MainWindow inherits Window {
    title: "Kova";
    icon: @image-url("../assets/kova_256.png");
    preferred-width: 1080px;
    preferred-height: 720px;
    min-width: 920px;
    min-height: 600px;
    background: Theme.bg;
    default-font-family: "맑은 고딕";
    
    in-out property <int> sel-mode: 0;
    in property <string> app-version;
    in property <[DriveRow]> drives;
    in property <[ImageRow]> images;
    in-out property <string> sel-drive;
    in-out property <string> img-path;
    property <string> eff-drive: root.sel-drive != "" ? root.sel-drive : (root.drives.length > 0 ? root.drives[0].name : "");
    in property <string> service-status;
    in property <bool> service-ok: true;
    in-out property <string> pick-error;
    in property <string> alert-text;
    in property <[ProfileRow]> profiles;
    in property <[SnapRow]> snapshots;
    in property <[AlertRow]> alerts;
    in property <[string]> setting-lines;
    in-out property <int> open-alert: -1;
    in property <string> log-text;
    callback run-backup(string);
    callback run-verify(string);
    callback run-gc(string);
    callback open-repo-dir(string);
    callback export-drivers();
    in-out property <int> settings-tab: 0;
    callback ack-alerts();
    callback check-update();
    in property <[RunRow]> running;
    callback cancel-job(int);
    in-out property <bool> job-completed-show: false;
    in-out property <bool> job-completed-ok: true;
    in-out property <string> job-completed-title: "";
    in-out property <string> job-completed-msg: "";
    callback dismiss-completed();
    callback save-settings(string, bool, bool, bool, bool);
    in-out property <string> form-min-free: "5";
    in-out property <bool> form-ransom: true;
    in-out property <bool> form-encrypt: false;
    in-out property <bool> form-vss: true;
    in-out property <bool> form-pack: false;
    in-out property <string> form-recovery: "";
    callback restore-key(string);
    callback export-recovery-kit();
    in-out property <string> form-webhook: "";
    in-out property <string> form-max-threads: "0";
    in-out property <string> form-bw-limit: "0";
    in-out property <bool> form-pause-battery: false;
    callback save-ops-settings(string, string, string, bool);
    callback test-webhook(string);
    in-out property <string> pe-iso-out: "";
    in-out property <string> pe-drivers-dir: "";
    in property <string> pe-text;
    callback build-pe-iso(string, string);
    in-out property <string> global-query: "";
    in property <[GlobalFileRow]> global-results;
    in property <string> global-status;
    callback global-search(string);
    callback global-restore(string, string, string, string);
    in-out property <string> form-lock-cur: "";
    in-out property <string> form-lock-new: "";
    in property <string> lock-text;
    callback unlock-app(string);
    callback set-master(string, string);
    in-out property <string> settings-text;
    in property <string> main-repo;
    callback verify-image(string);
    callback restore-image(string, string);
    callback capture-image(string, string);
    callback delete-image(string);
    callback scan-convert();
    in property <[ImageRow]> conv-cands;
    in-out property <string> conv-src;
    in-out property <string> confirm-del;
    callback capture-volume(string);
    callback restore-snapshot(string, string, string);
    callback restore-inplace(string, string);
    callback delete-snapshot(string, string);
    in-out property <string> snap-pending;
    in-out property <bool> restore-orig: true;
    in-out property <string> restore-folder: root.default-restore;
    in-out property <bool> browse-confirm: false;
    callback open-browse(string, string, string);
    callback browse-go(string);
    callback browse-up();
    callback browse-search(string);
    callback browse-toggle(string);
    callback browse-restore(string);
    in-out property <bool> browse-open: false;
    in property <string> browse-title;
    in property <string> browse-dir;
    in property <string> browse-status;
    in property <int> browse-selected;
    in property <[BrowseRow]> browse-items;
    in property <string> restore-text;
    callback browse(string, string);
    callback make-diag();
    in property <string> diag-text;
    callback save-profile(string, string, string, string, string, string, bool, bool, string, string, string, string);
    callback edit-profile(string);
    callback estimate-size(string);
    callback delete-profile(string);
    in-out property <string> form-id;
    in-out property <string> form-name;
    in-out property <string> form-sources;
    in property <[SrcRow]> form-list;
    callback sync-form-list(string);
    callback form-add(string);
    callback form-remove(string);
    in property <int> form-missing;
    callback form-clean();
    in-out property <bool> prog-shown: false;
    in-out property <bool> more-settings: false;
    in property <[ProgPick]> prog-list;
    in property <int> prog-count;
    callback prog-open();
    callback prog-toggle(int);
    callback prog-apply();
    callback prog-close();
    changed form-sources => { root.sync-form-list(root.form-sources); }
    in-out property <string> form-repo;
    in-out property <string> form-count: "30";
    in-out property <string> form-days: "60";
    in-out property <bool> form-auto: false;
    in-out property <bool> form-daily: false;
    in-out property <string> form-sched: "12";
    in-out property <string> form-exclude: "";
    in-out property <string> form-weekly: "0";
    in-out property <string> form-monthly: "0";
    in-out property <string> delete-pending;
    in property <string> form-text;
    in property <string> image-text;
    in property <string> volume-text;
    in-out property <string> vol-img;
    in-out property <string> vol-letter;
    in-out property <string> vol-phrase;
    callback volume-check(string);
    callback restore-volume(string, string, string);
    callback install-update();
    in property <string> update-text;
    callback save-offsite(string, string);
    callback connect-gdrive();
    callback disconnect-gdrive();
    in-out property <bool> gdrive-connected: false;
    in-out property <string> gdrive-text;
    callback run-drill();
    callback export-sysinfo();
    in property <[OffsiteRow]> offsite-rows;
    in-out property <int> page: 0;
    in-out property <bool> advanced: false;
    callback known-folder(string) -> string;
    callback quick-start(string, string);
    in-out property <string> wz-src: "";
    in property <[string]> wz-list;
    callback wz-add(string);
    callback wz-remove(int);
    in-out property <string> wz-repo: "";
    in-out property <string> default-restore: "";
    in property <string> wz-text;
    
    out property <color> hero-tone: !service-ok ? Theme.danger : profiles.length == 0 ? Theme.accent : alert-text != "" ? Theme.warn : Theme.ok;
    out property <string> hero-title: !service-ok ? "백업 프로그램이 꺼져 있습니다" : profiles.length == 0 ? "아직 백업이 설정되지 않았습니다" : alert-text != "" ? "확인이 필요한 문제가 있습니다" : "내 파일이 안전하게 보호되고 있습니다";
    out property <string> hero-pill: !service-ok ? "꺼짐" : profiles.length == 0 ? "설정 필요" : alert-text != "" ? "확인 필요" : "안전해요";
    out property <string> hero-sub: !service-ok ? "컴퓨터를 다시 시작해 보세요. 계속되면 Kova를 다시 설치하세요." : profiles.length == 0 ? "아래 세 단계만 따라 하면 끝납니다." : alert-text != "" ? "왼쪽의 '알림'을 눌러 내용을 확인하세요." : "마지막 백업: " + (snapshots.length > 0 ? snapshots[0].when : "아직 없음");

    HorizontalLayout {
        // LEFT SIDEBAR (260px) - Windows 11 Fluent Tiny11 Builder Style
        Rectangle {
            width: 260px;
            background: Theme.side;
            border-width: 0px;
            
            // Right hairline border
            Rectangle {
                x: parent.width - 1px;
                width: 1px;
                background: Theme.line;
            }
            
            VerticalLayout {
                padding: 18px;
                spacing: 16px;
                
                // Brand Header
                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;
                    Rectangle {
                        width: 34px;
                        height: 34px;
                        border-radius: 9px;
                        background: Theme.accent;
                        Text {
                            text: "K";
                            color: #ffffff;
                            font-size: 19px;
                            font-weight: 900;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 1px;
                        HorizontalLayout {
                            spacing: 6px;
                            Text {
                                text: "KOVA";
                                color: Theme.text;
                                font-size: 18px;
                                font-weight: 800;
                                letter-spacing: 0.5px;
                                vertical-alignment: center;
                            }
                            Rectangle {
                                height: 18px;
                                border-radius: 5px;
                                border-width: 1px;
                                border-color: Theme.line;
                                background: Theme.bg-subtle;
                                min-width: vtxt.preferred-width + 8px;
                                vtxt := Text {
                                    text: "v" + root.app-version;
                                    color: Theme.muted;
                                    font-size: 10px;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        Text {
                            text: "Fluent Backup Engine";
                            color: Theme.muted;
                            font-size: 10px;
                        }
                    }
                }
                
                Rectangle { height: 1px; background: Theme.line; }
                
                // Section Label
                Text {
                    text: "NAVIGATION";
                    color: Theme.muted;
                    font-size: 11px;
                    font-weight: 700;
                    letter-spacing: 0.5px;
                }
                
                // 3 Core Stepper Navigation Items
                VerticalLayout {
                    spacing: 8px;
                    
                    NavStepItem {
                        step-num: "1";
                        title: "홈 & 빠른 백업";
                        sub: "빠른 백업 및 보호 상태";
                        active: root.page == 0 || root.page == 1 || root.page == 4;
                        clicked => { root.page = 0; }
                    }
                    
                    NavStepItem {
                        step-num: "2";
                        title: "파일 되돌리기 복원";
                        sub: "스냅샷 시점 복원 & 검색";
                        active: root.page == 2;
                        clicked => { root.page = 2; }
                    }
                    
                    NavStepItem {
                        step-num: "3";
                        title: "환경설정 & 비상도구";
                        sub: "일정, 보안 & WinPE";
                        active: root.page == 5;
                        clicked => { root.page = 5; }
                    }

                    NavStepItem {
                        step-num: root.alert-text != "" ? "!" : "🔔";
                        title: "알림 & 경고 내역";
                        sub: root.alert-text != "" ? root.alert-text : "시스템 알림 및 경고 기록";
                        active: root.page == 3;
                        clicked => { root.page = 3; }
                    }
                }
                
                Rectangle { vertical-stretch: 1; }
                
                // Bottom: Repository Status Mini Card (클릭 시 윈도우 탐색기로 백업 저장소 폴더 즉시 열기)
                Card {
                    vertical-stretch: 0;
                    height: 94px;
                    background: Theme.card;
                    border-color: Theme.line;
                    VerticalLayout {
                        padding: 10px;
                        spacing: 6px;
                        alignment: center;
                        HorizontalLayout {
                            Text {
                                text: "저장소 상태";
                                color: Theme.muted;
                                font-size: 11px;
                                font-weight: 600;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: root.drives.length > 0 ? (root.drives[0].free + " 여유") : "정상";
                                color: Theme.ok;
                                font-size: 11px;
                                font-weight: 700;
                            }
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            Text {
                                text: root.form-repo != "" ? root.form-repo : (root.main-repo != "" ? root.main-repo : "아직 백업 설정 전");
                                color: Theme.text;
                                font-size: 12px;
                                font-weight: 600;
                                overflow: elide;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            Btn {
                                text: "📂 열기";
                                height: 24px;
                                clicked => {
                                    root.open-repo-dir(root.form-repo != "" ? root.form-repo : root.main-repo);
                                }
                            }
                        }
                        Meter {
                            pct: root.drives.length > 0 ? root.drives[0].pct : 35;
                            tone: Theme.accent;
                        }
                    }
                }
                
                // Theme Mode Toggle
                Btn {
                    text: Theme.dark ? "☀️ 라이트 모드로 전환" : "🌙 다크 모드로 전환";
                    clicked => { Theme.dark = !Theme.dark; }
                }
            }
        }

        // RIGHT MAIN CANVAS
        VerticalLayout {
            horizontal-stretch: 1;
            
            // Subheader Status Strip
            Rectangle {
                height: 34px;
                background: Theme.bg-subtle;
                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Theme.line;
                }
                HorizontalLayout {
                    padding-left: 24px;
                    padding-right: 24px;
                    spacing: 12px;
                    alignment: center;
                    
                    Rectangle {
                        width: 8px;
                        height: 8px;
                        y: 13px;
                        border-radius: 4px;
                        background: root.hero-tone;
                    }
                    Text {
                        text: root.service-ok ? "안전 보관: 정상 가동" : "백업 서비스 중단됨";
                        color: root.hero-tone;
                        font-size: 12px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "• " + root.service-status;
                        color: Theme.muted;
                        font-size: 12px;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    if root.pick-error != "": Badge { text: root.pick-error; tone: Theme.danger; y: 5px; }
                    if root.alert-text != "": Rectangle {
                        height: 28px;
                        border-radius: 14px;
                        background: ta-header-alert.has-hover ? Theme.danger.with-alpha(0.24) : Theme.danger.with-alpha(0.16);
                        border-width: 1px;
                        border-color: ta-header-alert.has-hover ? Theme.danger : Theme.danger.with-alpha(0.4);
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 12px;
                            spacing: 6px;
                            alignment: center;
                            Rectangle {
                                width: 6px;
                                height: 6px;
                                border-radius: 3px;
                                background: Theme.danger;
                            }
                            Text {
                                text: root.alert-text;
                                color: Theme.danger;
                                font-size: 11px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "→ 보기";
                                color: Theme.danger;
                                font-size: 11px;
                                font-weight: 800;
                                vertical-alignment: center;
                            }
                        }
                        ta-header-alert := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.page = 3; }
                        }
                    }
                }
            }
            
            // Main View Area
            VerticalLayout {
                padding: 24px;
                padding-top: 16px;
                spacing: 14px;
                vertical-stretch: 1;

                // Dedicated Active Running Card (전체 화면 공통 실시간 러너)
                if root.running.length > 0: Card {
                    border-color: Theme.accent;
                    border-width: 1px;
                    background: Theme.dark ? #121c2e : #eff6ff;
                    VerticalLayout {
                        padding: 14px;
                        spacing: 10px;
                        for r in root.running: VerticalLayout {
                            spacing: 8px;
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: center;
                                Rectangle {
                                    width: 8px;
                                    height: 8px;
                                    border-radius: 4px;
                                    background: Theme.accent;
                                }
                                Text {
                                    text: r.kind == "verify" ? "무결성 검사 진행 중" : (r.kind == "gc" ? "저장소 정리 진행 중" : (r.kind == "delsnap" ? "스냅샷 삭제 중" : (r.kind != "" && r.kind != "backup" ? r.kind + " 진행 중" : "백업 진행 중")));
                                    color: Theme.accent;
                                    font-size: 12px;
                                    font-weight: 800;
                                }
                                Text {
                                    text: "• " + r.name;
                                    color: Theme.text;
                                    font-size: 13px;
                                    font-weight: 700;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                                Badge {
                                    text: r.pct + "%";
                                    tone: Theme.accent;
                                }
                                if r.cancellable: Btn {
                                    text: "작업 중단";
                                    kind: 2;
                                    height: 28px;
                                    clicked => { root.cancel-job(r.id); }
                                }
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                Text {
                                    text: "현재 처리:";
                                    color: Theme.muted;
                                    font-size: 12px;
                                    font-weight: 600;
                                }
                                Text {
                                    text: r.current != "" ? r.current : (r.kind == "verify" ? "스냅샷 및 데이터 블롭 무결성 검증 중..." : (r.kind == "gc" ? "고아 블롭 및 저장소 데이터 정리 중..." : (r.kind == "backup" ? "파일 분석 및 백업 준비 중..." : "작업 준비 중...")));
                                    color: Theme.muted;
                                    font-size: 12px;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                            }
                            Meter {
                                pct: r.pct;
                                tone: Theme.accent;
                                height: 8px;
                            }
                        }
                    }
                }

                // Dedicated Job Completion Banner / Card (전체 화면 공통 완료 카드)
                if root.job-completed-show && root.running.length == 0: Card {
                    border-color: root.job-completed-ok ? Theme.ok : Theme.danger;
                    border-width: 1px;
                    background: root.job-completed-ok ? (Theme.dark ? #0f241a : #f0fdf4) : (Theme.dark ? #2a1215 : #fef2f2);
                    VerticalLayout {
                        padding: 14px;
                        spacing: 8px;
                        HorizontalLayout {
                            spacing: 10px;
                            alignment: center;
                            Rectangle {
                                width: 22px;
                                height: 22px;
                                border-radius: 11px;
                                background: root.job-completed-ok ? Theme.ok : Theme.danger;
                                Text {
                                    text: root.job-completed-ok ? "OK" : "!";
                                    color: #ffffff;
                                    font-size: root.job-completed-ok ? 9px : 13px;
                                    font-weight: 900;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                            Text {
                                text: root.job-completed-title;
                                color: root.job-completed-ok ? Theme.ok : Theme.danger;
                                font-size: 14px;
                                font-weight: 800;
                                vertical-alignment: center;
                            }
                            Rectangle { horizontal-stretch: 1; }
                            if !root.job-completed-ok: Btn {
                                text: "알림 내역 보기";
                                kind: 2;
                                height: 28px;
                                clicked => { root.dismiss-completed(); root.page = 3; }
                            }
                            Btn {
                                text: "확인";
                                kind: root.job-completed-ok ? 1 : 0;
                                height: 28px;
                                clicked => { root.dismiss-completed(); }
                            }
                        }
                        if root.job-completed-msg != "": Text {
                            text: root.job-completed-msg;
                            color: Theme.muted;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }
                }

                // PAGE 0: HOME & BACKUP (Tiny11 Builder Clean Fluent UI)
                if root.page == 0: VerticalLayout {
                    spacing: 18px;
                    vertical-stretch: 1;
                    
                    // Giant Watermark "1" & Welcome Header
                    Rectangle {
                        height: 80px;
                        background: transparent;
                        
                        Text {
                            x: parent.width - 90px;
                            y: -24px;
                            text: "1";
                            font-size: 130px;
                            font-weight: 900;
                            color: Theme.dark ? #ffffff0d : #0000000a;
                        }
                        
                        VerticalLayout {
                            alignment: center;
                            spacing: 3px;
                            Text {
                                text: "STEP 01  •  BACKUP & PROTECTION";
                                color: Theme.accent;
                                font-size: 11px;
                                font-weight: 700;
                                letter-spacing: 0.5px;
                            }
                            Text {
                                text: "Welcome";
                                color: Theme.text;
                                font-size: 26px;
                                font-weight: 800;
                            }
                            Text {
                                text: "원클릭으로 PC와 중요 데이터를 안전하게 보호하세요.";
                                color: Theme.muted;
                                font-size: 13px;
                            }
                        }
                    }
                    
                    // 3 대형 백업 모드 카드 (스마트 자동 / PC 전체 통백업 / 사용자 정의 맞춤)
                    HorizontalLayout {
                        spacing: 16px;
                        vertical-stretch: 1;
                        
                        ModeCard {
                            horizontal-stretch: 1;
                            badge-text: "★ 스마트 추천";
                            icon-text: "⚡";
                            title: "스마트 자동 백업";
                            desc: "문서, 사진, 바탕화면 등 중요 개인 파일만 골라 실시간 증분으로 안전하게 백업합니다.";
                            f1: "문서 · 사진 · 바탕화면 자동 감지";
                            f2: "실시간 변경분 초고속 증분 백업";
                            f3: "랜섬웨어 변조 차단 및 스냅샷 격리";
                            tag: "★ 스마트 추천 • 일상 백업";
                            selected: root.sel-mode == 0;
                            clicked => {
                                root.sel-mode = 0;
                            }
                        }
                        
                        ModeCard {
                            horizontal-stretch: 1;
                            badge-text: "전체 디스크";
                            icon-text: "🖥️";
                            title: "PC 전체 통백업";
                            desc: "윈도우 OS, 프로그램, 설정까지 C: 드라이브 전체를 .qblk 이미지로 통째로 보관합니다.";
                            f1: "Windows C: 드라이브 전체 이미지";
                            f2: "OS, 프로그램, 드라이버 통째로 보관";
                            f3: "부팅 불가 시 WinPE 비상 복원 지원";
                            tag: "VSS 스냅샷 • 베어메탈 복구";
                            selected: root.sel-mode == 1;
                            clicked => {
                                root.sel-mode = 1;
                            }
                        }
                        
                        ModeCard {
                            horizontal-stretch: 1;
                            badge-text: "커스텀";
                            icon-text: "⚙️";
                            title: "사용자 정의 맞춤";
                            desc: "백업할 폴더, 제외 확장자, 자동 실행 주기(매일/매주/매월)를 직접 세밀하게 구성합니다.";
                            f1: "원하는 폴더 및 드라이브 직접 지정";
                            f2: "제외 확장자 및 세밀한 압축 규칙";
                            f3: "매일 / 매주 / 매월 다중 스케줄 관리";
                            tag: "고급 설정 • 커스텀 보관";
                            selected: root.sel-mode == 2;
                            clicked => {
                                root.sel-mode = 2;
                            }
                        }
                    }
                    
                    Rectangle { vertical-stretch: 1; }

                    if root.wz-text != "": Text { text: root.wz-text; color: Theme.warn; font-size: 13px; wrap: word-wrap; }

                    // Bottom Service Status & Giant CTA Button
                    Card {
                        vertical-stretch: 0;
                        height: 72px;
                        background: Theme.card;
                        border-color: Theme.line;
                        
                        HorizontalLayout {
                            padding-left: 20px;
                            padding-right: 20px;
                            spacing: 16px;
                            
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 10px;
                                    height: 10px;
                                    border-radius: 5px;
                                    background: root.hero-tone;
                                }
                            }
                            
                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                horizontal-stretch: 1;
                                
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: root.service-ok ? "백업 엔진 정상 작동 중" : "백업 서비스 중단됨";
                                        color: root.hero-tone;
                                        font-size: 13px;
                                        font-weight: 700;
                                    }
                                }
                                Text {
                                    text: root.service-status;
                                    color: Theme.muted;
                                    font-size: 11px;
                                    overflow: elide;
                                }
                            }
                            
                            VerticalLayout {
                                alignment: center;
                                Btn {
                                    text: root.sel-mode == 0 ? "스마트 백업 시작 →" : (root.sel-mode == 1 ? "PC 전체 통백업 설정 →" : "사용자 맞춤 설정 →");
                                    kind: 1;
                                    height: 46px;
                                    min-width: 190px;
                                    clicked => {
                                        if root.sel-mode == 0 {
                                            root.dismiss-completed();
                                            if root.profiles.length > 0 {
                                                root.run-backup(root.profiles[0].id);
                                            } else {
                                                root.quick-start(root.wz-src != "" ? root.wz-src : (root.known-folder("documents") + ";" + root.known-folder("pictures") + ";" + root.known-folder("desktop")), root.wz-repo);
                                            }
                                        } else if root.sel-mode == 1 {
                                            root.page = 4;
                                        } else {
                                            root.page = 1;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // PAGE 1: PROFILES & SCHEDULE (ADVANCED / CUSTOM)
                if root.page == 1: ScrollView {
                    VerticalLayout {
                        spacing: 14px;
                        
                        HorizontalLayout {
                            spacing: 12px;
                            alignment: start;
                            Btn { text: "← 홈으로 돌아가기"; clicked => { root.page = 0; } }
                            Heading { text: "사용자 정의 맞춤 백업 프로파일"; vertical-alignment: center; }
                        }
                        
                    
                    // Existing Profiles Card
                    Card {
                        VerticalLayout {
                            padding: 8px;
                            for p in root.profiles: Rectangle {
                                height: 54px;
                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    spacing: 10px;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        alignment: center;
                                        spacing: 2px;
                                        Text { text: p.name; color: Theme.text; font-size: 14px; font-weight: 700; overflow: elide; }
                                        Text { text: p.detail; color: Theme.muted; font-size: 12px; overflow: elide; }
                                    }
                                    Btn { text: "설정 수정"; y: 11px; clicked => { root.delete-pending = ""; root.edit-profile(p.id); } }
                                    Btn {
                                        text: root.delete-pending == p.id ? "정말 삭제" : "삭제";
                                        kind: 2;
                                        y: 11px;
                                        clicked => {
                                            if (root.delete-pending == p.id) {
                                                root.delete-pending = "";
                                                root.delete-profile(p.id);
                                            } else {
                                                root.delete-pending = p.id;
                                            }
                                        }
                                    }
                                }
                                Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
                            }
                        }
                    }

                    // Profile Edit / Form Card
                    Card {
                        VerticalLayout {
                            padding: 18px;
                            spacing: 12px;
                            
                            Heading { text: root.form-id == "" ? "새 백업 프로파일 만들기" : "백업 프로파일 설정 수정"; }
                            Field { text <=> root.form-name; placeholder: "프로파일 이름 (예: 업무 문서 백업)"; }
                            
                            Text { text: "백업 대상 폴더 및 프로그램"; color: Theme.text; font-size: 13px; font-weight: 600; }
                            if root.form-list.length == 0: Text { text: "선택된 폴더가 없습니다. 아래 '+ 폴더 추가' 버튼을 눌러 지정하세요."; color: Theme.muted; font-size: 13px; }
                            
                            // Sources List
                            Card {
                                background: Theme.bg-subtle;
                                VerticalLayout {
                                    padding: 8px;
                                    spacing: 4px;
                                    for f in root.form-list: Rectangle {
                                        height: f.kind == 0 ? 28px : 44px;
                                        border-radius: 6px;
                                        border-width: f.kind == 0 ? 0px : 1px;
                                        border-color: Theme.line;
                                        background: f.kind == 0 ? transparent : Theme.card;
                                        HorizontalLayout {
                                            padding-left: f.kind == 0 ? 4px : 10px;
                                            padding-right: 6px;
                                            spacing: 8px;
                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                alignment: center;
                                                Text { text: f.title; color: f.kind == 0 ? Theme.muted : Theme.text; font-size: f.kind == 0 ? 12px : 13px; font-weight: f.kind == 0 ? 700 : 500; overflow: elide; }
                                                if f.kind != 0: Text { text: f.sub; color: Theme.muted; font-size: 11px; overflow: elide; }
                                            }
                                            if f.kind != 0: Btn { text: "제외"; y: 6px; clicked => { root.form-remove(f.key); } }
                                        }
                                    }
                                }
                            }

                            HorizontalLayout {
                                alignment: start;
                                spacing: 8px;
                                Btn { text: "📁 + 폴더 추가"; kind: 1; clicked => { root.browse("folders", "form-add"); } }
                                Btn { text: "💻 + 프로그램 추가"; kind: 1; clicked => { root.prog-open(); } }
                                if root.form-missing > 0: Btn { text: "없는 항목 " + root.form-missing + "개 정리"; kind: 2; clicked => { root.form-clean(); } }
                            }

                            // Program Picker Modal / Card
                            if root.prog-shown: Card {
                                background: Theme.bg-subtle;
                                border-color: Theme.accent;
                                VerticalLayout {
                                    padding: 14px;
                                    spacing: 10px;
                                    Text { text: "추가할 프로그램 선택 (복수 선택 가능)"; color: Theme.text; font-size: 13px; font-weight: 700; }
                                    if root.prog-list.length == 0: Text { text: "감지된 추가 가능 프로그램이 없습니다."; color: Theme.muted; font-size: 13px; }
                                    
                                    for p[i] in root.prog-list: Rectangle {
                                        height: 36px;
                                        border-radius: 6px;
                                        border-width: 1px;
                                        border-color: p.checked ? Theme.accent : Theme.line;
                                        background: p.checked ? Theme.accent.with-alpha(0.18) : Theme.card;
                                        HorizontalLayout {
                                            padding-left: 12px;
                                            padding-right: 12px;
                                            spacing: 8px;
                                            Text { text: p.name; color: Theme.text; font-size: 13px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                                            Text { text: p.checked ? "선택됨" : p.sub; color: p.checked ? Theme.accent : Theme.muted; font-size: 12px; vertical-alignment: center; }
                                        }
                                        TouchArea { clicked => { root.prog-toggle(i); } }
                                    }
                                    
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Btn { text: "선택한 " + root.prog-count + "개 추가"; kind: 1; clicked => { root.prog-apply(); } }
                                        Btn { text: "닫기"; clicked => { root.prog-close(); } }
                                    }
                                }
                            }

                            PathField { text <=> root.form-repo; target: "form-repo"; placeholder: "백업 저장소 대상 폴더 전체 경로"; pick(k, t) => { root.browse(k, t); } }

                            // Schedule Settings
                            Card {
                                background: Theme.bg-subtle;
                                VerticalLayout {
                                    padding: 12px;
                                    spacing: 10px;
                                    HorizontalLayout {
                                        spacing: 10px;
                                        Text { text: "자동 백업 실행"; color: Theme.text; font-size: 13px; font-weight: 600; vertical-alignment: center; }
                                        Btn { text: root.form-auto ? "켜짐" : "꺼짐"; kind: root.form-auto ? 1 : 0; clicked => { root.form-auto = !root.form-auto; } }
                                        Btn { text: root.form-daily ? "매일 지정 시각" : "주기적 시간 간격"; clicked => { root.form-daily = !root.form-daily; root.form-sched = root.form-daily ? "02:00" : "12"; } }
                                        Field { text <=> root.form-sched; width: 80px; }
                                        Text { text: root.form-daily ? "실행 (HH:MM)" : "시간마다 실행"; color: Theme.muted; font-size: 12px; vertical-alignment: center; }
                                        Rectangle { horizontal-stretch: 1; }
                                    }
                                }
                            }

                            Field { text <=> root.form-exclude; placeholder: "제외할 패턴 (예: *.tmp;*.log;node_modules;.git)"; }
                            HorizontalLayout {
                                spacing: 8px;
                                Btn {
                                    text: "+ 임시파일 제외";
                                    clicked => {
                                        root.form-exclude = root.form-exclude + (root.form-exclude == "" ? "" : ";") + "*.tmp;*.temp;*.swp;~$*";
                                    }
                                }
                                Btn {
                                    text: "+ 빌드/git 제외";
                                    clicked => {
                                        root.form-exclude = root.form-exclude + (root.form-exclude == "" ? "" : ";") + "node_modules;.git;target;*.obj;*.pdb";
                                    }
                                }
                                Btn {
                                    text: "+ 휴지통/가상머신 제외";
                                    clicked => {
                                        root.form-exclude = root.form-exclude + (root.form-exclude == "" ? "" : ";") + "$RECYCLE.BIN;*.vmdk;*.vdi;*.vhdx";
                                    }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }

                            // Retention Rules
                            Card {
                                background: Theme.bg-subtle;
                                VerticalLayout {
                                    padding: 12px;
                                    spacing: 10px;
                                    HorizontalLayout {
                                        spacing: 10px;
                                        Text { text: "보관 개수"; color: Theme.text-sub; font-size: 12px; vertical-alignment: center; }
                                        Field { text <=> root.form-count; width: 70px; }
                                        Text { text: "보관 일수"; color: Theme.text-sub; font-size: 12px; vertical-alignment: center; }
                                        Field { text <=> root.form-days; width: 70px; }
                                        Text { text: "주 단위 보존"; color: Theme.text-sub; font-size: 12px; vertical-alignment: center; }
                                        Field { text <=> root.form-weekly; width: 60px; }
                                        Text { text: "월 단위 보존"; color: Theme.text-sub; font-size: 12px; vertical-alignment: center; }
                                        Field { text <=> root.form-monthly; width: 60px; }
                                        Rectangle { horizontal-stretch: 1; }
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                Rectangle { horizontal-stretch: 1; }
                                Btn { text: "예상 크기 계산"; clicked => { root.estimate-size(root.form-id); } }
                                Btn { 
                                    text: "입력 초기화"; 
                                    clicked => { 
                                        root.form-id = ""; 
                                        root.form-name = ""; 
                                        root.form-sources = ""; 
                                        root.form-repo = ""; 
                                        root.form-count = "30"; 
                                        root.form-days = "60"; 
                                        root.form-auto = false; 
                                        root.form-daily = false; 
                                        root.form-sched = "12"; 
                                        root.form-exclude = ""; 
                                        root.form-weekly = "0"; 
                                        root.form-monthly = "0"; 
                                        root.delete-pending = ""; 
                                    } 
                                }
                                Btn { 
                                    text: root.form-id == "" ? "프로파일 저장" : "변경사항 적용"; 
                                    kind: 1; 
                                    clicked => { 
                                        root.save-profile(root.form-id, root.form-name, root.form-sources, root.form-repo, root.form-count, root.form-days, root.form-auto, root.form-daily, root.form-sched, root.form-exclude, root.form-weekly, root.form-monthly); 
                                    } 
                                }
                            }
                            if root.form-text != "": Text { text: root.form-text; color: Theme.warn; font-size: 13px; wrap: word-wrap; }
                        }
                    }
                }
            }



                // PAGE 2: RESTORE & HISTORY
                if root.page == 2: VerticalLayout {
                    spacing: 12px;
                    
                    // Giant Watermark "2" & Header
                    Rectangle {
                        height: 76px;
                        background: transparent;
                        
                        Text {
                            x: parent.width - 90px;
                            y: -24px;
                            text: "2";
                            font-size: 130px;
                            font-weight: 900;
                            color: Theme.dark ? #ffffff0d : #0000000a;
                        }
                        
                        VerticalLayout {
                            alignment: center;
                            spacing: 3px;
                            Text {
                                text: "STEP 02  •  POINT-IN-TIME RESTORE";
                                color: Theme.accent;
                                font-size: 11px;
                                font-weight: 700;
                                letter-spacing: 0.5px;
                            }
                            Text {
                                text: "Restore";
                                color: Theme.text;
                                font-size: 26px;
                                font-weight: 800;
                            }
                            Text {
                                text: "보관된 시점별 스냅샷에서 필요한 파일과 폴더를 안전하게 되돌립니다.";
                                color: Theme.muted;
                                font-size: 13px;
                            }
                        }
                    }
                    
                
                // Destination Mode Selector Card
                Card {
                    VerticalLayout {
                        padding: 16px;
                        spacing: 10px;
                        HorizontalLayout {
                            Heading { text: "파일 되돌리기 (복원 모드)"; }
                            Rectangle { horizontal-stretch: 1; }
                            Btn {
                                text: "저장소 정리 (GC / 조각 모음)";
                                height: 32px;
                                clicked => {
                                    root.run-gc(root.form-id);
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            Btn { 
                                text: "📂 원래 자리에 되돌리기 (기본)"; 
                                kind: root.restore-orig ? 1 : 0; 
                                clicked => { root.restore-orig = true; root.snap-pending = ""; root.browse-confirm = false; } 
                            }
                            Btn { 
                                text: "📁 다른 폴더에 따로 꺼내기"; 
                                kind: root.restore-orig ? 0 : 1; 
                                clicked => { root.restore-orig = false; root.snap-pending = ""; root.browse-confirm = false; } 
                            }
                        }
                        if root.restore-orig: Hint { text: "백업했던 원래 경로로 파일을 복원합니다. 동일한 파일이 존재하는 경우 덮어쓰기 전에 최종 확인합니다."; }
                        if !root.restore-orig: PathField { text <=> root.restore-folder; target: "restore-folder"; placeholder: "복원할 파일을 안전하게 보관할 새 폴더 경로"; pick(k, t) => { root.browse(k, t); } }
                    }
                }

                // File Browser View (Sub-view)
                if root.browse-open: VerticalLayout {
                    spacing: 10px;
                    vertical-stretch: 1;
                    
                    Card {
                        height: 48px;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 8px;
                            Btn { text: "← 목록으로"; clicked => { root.browse-open = false; root.browse-confirm = false; } }
                            Btn { text: "상위 폴더"; clicked => { root.browse-up(); } }
                            Text { text: root.browse-title + "  /  " + root.browse-dir; color: Theme.text; font-size: 13px; font-weight: 600; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                            bq := Field { placeholder: "파일 검색"; width: 180px; }
                            Btn { text: "검색"; clicked => { root.browse-search(bq.text); } }
                        }
                    }

                    Card {
                        vertical-stretch: 1;
                        ListView {
                            for it in root.browse-items: Rectangle {
                                height: 38px;
                                HorizontalLayout {
                                    padding-left: 14px;
                                    padding-right: 14px;
                                    spacing: 10px;
                                    
                                    // Checkbox box
                                    Rectangle {
                                        width: 18px;
                                        height: 18px;
                                        y: 10px;
                                        border-radius: 4px;
                                        border-width: 1px;
                                        border-color: it.selected ? Theme.accent : Theme.line;
                                        background: it.selected ? Theme.accent : transparent;
                                        Text { text: it.selected ? "●" : ""; color: #ffffff; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                                        TouchArea { clicked => { root.browse-toggle(it.path); } }
                                    }
                                    
                                    // Folder / File Name
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        Text { 
                                            text: (it.is-dir ? "📁 " : "📄 ") + it.name; 
                                            color: it.is-dir ? Theme.accent : Theme.text; 
                                            font-size: 13px; 
                                            font-weight: it.is-dir ? 700 : 400; 
                                            vertical-alignment: center; 
                                            overflow: elide; 
                                            width: parent.width; 
                                        }
                                        TouchArea { clicked => { if (it.is-dir) { root.browse-go(it.path); } else { root.browse-toggle(it.path); } } }
                                    }
                                    
                                    Text { text: it.info; color: Theme.muted; font-size: 12px; width: 140px; horizontal-alignment: right; vertical-alignment: center; }
                                }
                                Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
                            }
                        }
                    }

                    Card {
                        height: 50px;
                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            spacing: 12px;
                            Text { 
                                text: root.browse-status != "" ? root.browse-status : "폴더를 클릭하면 탐색하며, 복원할 항목을 체크박스로 선택하세요."; 
                                color: Theme.muted; 
                                font-size: 12px; 
                                vertical-alignment: center; 
                                horizontal-stretch: 1; 
                                overflow: elide; 
                            }
                            Badge { text: root.browse-selected + "개 선택됨"; tone: Theme.accent; y: 13px; }
                            Btn {
                                text: !root.restore-orig ? "체크한 파일 꺼내기" : root.browse-confirm ? "⚠️ 최종 덮어쓰기 확인" : "선택 파일 되돌리기";
                                kind: root.restore-orig && root.browse-confirm ? 2 : 1;
                                y: 9px;
                                clicked => {
                                    if (!root.restore-orig) {
                                        root.browse-restore(root.restore-folder);
                                    } else if (root.browse-confirm) {
                                        root.browse-confirm = false;
                                        root.browse-restore("@원래자리");
                                    } else {
                                        root.browse-confirm = true;
                                    }
                                }
                            }
                        }
                    }
                }

                // Cross-Snapshot Global Search (Chosung + Version History)
                if !root.browse-open: Card {
                    VerticalLayout {
                        padding: 14px;
                        spacing: 8px;
                        HorizontalLayout {
                            spacing: 8px;
                            Field { text <=> root.global-query; placeholder: "전체 스냅샷 통합 파일 검색 (파일명·초성 지원, 예: 보고서 / ㅂㄱㅅ)"; horizontal-stretch: 1; }
                            Btn { text: "전체 검색"; kind: 1; clicked => { root.global-search(root.global-query); } }
                        }
                        if root.global-status != "": Hint { text: root.global-status; }
                        if root.global-results.length > 0: ListView {
                            height: min(root.global-results.length * 46px, 210px);
                            for g in root.global-results: Rectangle {
                                height: 46px;
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 10px;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        alignment: center;
                                        spacing: 2px;
                                        Text { text: "📄 " + g.filename; color: Theme.text; font-size: 13px; font-weight: 600; overflow: elide; }
                                        Text { text: g.rel-path + " · " + g.info; color: Theme.muted; font-size: 11px; overflow: elide; }
                                    }
                                    Badge { text: g.versions; tone: Theme.accent; y: 11px; }
                                    Btn { text: "이 시점 열기"; height: 28px; y: 9px; clicked => { root.browse-confirm = false; root.browse-open = true; root.open-browse(g.repo, g.snapshot-id, g.snapshot-id); } }
                                    Btn {
                                        // 원래 자리 복원은 현재 파일을 덮어쓰므로 두 번 눌러야 실행한다(스냅샷 목록의 '정말 덮어쓰기'와 같은 방식)
                                        text: !root.restore-orig ? "꺼내기" : root.snap-pending == "G" + g.repo + g.snapshot-id + g.rel-path ? "정말 덮어쓰기" : "원래 자리 복원";
                                        kind: root.restore-orig && root.snap-pending == "G" + g.repo + g.snapshot-id + g.rel-path ? 2 : 1;
                                        height: 28px;
                                        y: 9px;
                                        clicked => {
                                            if (!root.restore-orig) {
                                                root.snap-pending = "";
                                                root.global-restore(g.repo, g.snapshot-id, g.rel-path, root.restore-folder);
                                            } else if (root.snap-pending == "G" + g.repo + g.snapshot-id + g.rel-path) {
                                                root.snap-pending = "";
                                                root.global-restore(g.repo, g.snapshot-id, g.rel-path, "@원래자리");
                                            } else {
                                                root.snap-pending = "G" + g.repo + g.snapshot-id + g.rel-path;
                                            }
                                        }
                                    }
                                }
                                Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
                            }
                        }
                    }
                }

                // Snapshots List
                if !root.browse-open: Card {
                    vertical-stretch: 1;
                    if root.snapshots.length == 0: Text {
                        text: "보관된 백업 스냅샷이 없습니다. 홈 화면에서 먼저 백업을 생성하세요.";
                        color: Theme.muted;
                        font-size: 13px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    ListView {
                        for s in root.snapshots: Rectangle {
                            height: 52px;
                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 16px;
                                spacing: 12px;
                                
                                Text { text: s.when; color: Theme.text; width: 90px; font-size: 13px; font-weight: 600; vertical-alignment: center; }
                                
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    spacing: 2px;
                                    Text { text: s.name; color: Theme.text; font-size: 13px; font-weight: 700; overflow: elide; }
                                    Text { text: s.summary; color: Theme.muted; font-size: 12px; overflow: elide; }
                                }
                                
                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 0;
                                    Badge {
                                        text: s.verified == "오류 있음" ? "오류 있음" : s.verified == "미검증" || s.verified == "" ? "미검증" : "무결성 검증";
                                        tone: s.verified == "오류 있음" ? Theme.danger : s.verified == "미검증" || s.verified == "" ? Theme.muted : Theme.ok;
                                    }
                                }

                                if s.verified == "미검증" || s.verified == "" || s.verified == "오류 있음": VerticalLayout {
                                    alignment: center;
                                    Btn {
                                        text: s.verified == "오류 있음" ? "🔍 다시 검사" : "🔍 무결성 검사";
                                        height: 32px; 
                                        clicked => { root.run-verify(s.profile-id != "" ? s.profile-id : s.id); } 
                                    }
                                }
                                
                                VerticalLayout {
                                    alignment: center;
                                    Btn { text: "개별 파일 탐색"; height: 32px; clicked => { root.browse-confirm = false; root.browse-open = true; root.open-browse(s.repo, s.id, s.when); } }
                                }
                                
                                VerticalLayout {
                                    alignment: center;
                                    Btn {
                                        text: !root.restore-orig ? "전부 꺼내기" : root.snap-pending == "R" + s.repo + s.id ? "정말 덮어쓰기" : "전체 되돌리기";
                                        kind: root.restore-orig && root.snap-pending == "R" + s.repo + s.id ? 2 : 1;
                                        height: 32px;
                                        clicked => {
                                            if (!root.restore-orig) {
                                                root.snap-pending = "";
                                                root.restore-snapshot(s.repo, s.id, root.restore-folder);
                                            } else if (root.snap-pending == "R" + s.repo + s.id) {
                                                root.snap-pending = "";
                                                root.restore-inplace(s.repo, s.id);
                                            } else {
                                                root.snap-pending = "R" + s.repo + s.id;
                                            }
                                        }
                                    }
                                }
                                
                                if root.advanced: VerticalLayout {
                                    alignment: center;
                                    Btn {
                                        text: root.snap-pending == "D" + s.repo + s.id ? "삭제 확인" : "삭제";
                                        kind: 2;
                                        height: 32px;
                                        clicked => {
                                            if (root.snap-pending == "D" + s.repo + s.id) {
                                                root.snap-pending = "";
                                                root.delete-snapshot(s.repo, s.id);
                                            } else {
                                                root.snap-pending = "D" + s.repo + s.id;
                                            }
                                        }
                                    }
                                }
                            }
                            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
                        }
                    }
                }
                if root.restore-text != "": Text { text: root.restore-text; color: Theme.warn; font-size: 13px; wrap: word-wrap; }
            }



                // PAGE 3: ALERTS
                if root.page == 3: VerticalLayout {
                    spacing: 12px;
                    
                    HorizontalLayout {
                        spacing: 12px;
                        alignment: start;
                        Btn { text: "← 돌아가기"; clicked => { root.page = 0; } }
                        Heading { text: "시스템 알림 및 경고 내역"; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                        Btn { text: "알림 모두 확인 완료"; kind: 1; clicked => { root.ack-alerts(); } }
                    }
                    
                Card {
                    vertical-stretch: 1;
                    if root.alerts.length == 0: VerticalLayout {
                        alignment: center;
                        spacing: 8px;
                        Text {
                            text: "🎉 확인이 필요한 알림이 없습니다.";
                            color: Theme.ok;
                            font-size: 15px;
                            font-weight: 700;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "모든 백업 및 무결성 검증이 문제 없이 안정적으로 수행되었습니다.";
                            color: Theme.muted;
                            font-size: 13px;
                            horizontal-alignment: center;
                        }
                    }
                    if root.alerts.length > 0: ListView {
                        for a[i] in root.alerts: Rectangle {
                            height: max(54px, hl-alert.preferred-height);
                            hl-alert := HorizontalLayout {
                                padding: 14px;
                                spacing: 14px;
                                Text { text: a.when; color: Theme.muted; width: 90px; font-size: 12px; vertical-alignment: top; }
                                VerticalLayout {
                                    alignment: start;
                                    Badge { text: a.level == "error" ? "오류" : (a.level == "warning" ? "경고" : a.level); tone: a.level == "error" ? Theme.danger : Theme.warn; }
                                }
                                Text { 
                                    text: root.open-alert == i ? a.full : a.message; 
                                    color: Theme.text; 
                                    font-size: 13px; 
                                    font-weight: a.ack ? 400 : 700; 
                                    horizontal-stretch: 1; 
                                    wrap: word-wrap; 
                                }
                                Text {
                                    text: root.open-alert == i ? "▲ 접기" : "▼ 상세보기";
                                    color: Theme.muted;
                                    font-size: 11px;
                                    vertical-alignment: top;
                                }
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.open-alert = root.open-alert == i ? -1 : i; }
                            }
                            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
                        }
                    }
                }
            }


                // PAGE 4: DISK IMAGE / BARE METAL BACKUP (ADVANCED)
                if root.page == 4: ScrollView {
                    VerticalLayout {
                        spacing: 14px;
                        
                        HorizontalLayout {
                            spacing: 12px;
                            alignment: start;
                            Btn { text: "← 홈으로 돌아가기"; clicked => { root.page = 0; } }
                            Heading { text: "PC 디스크 전체 백업 (.qblk 이미지 / 베어메탈)"; vertical-alignment: center; }
                        }
                        
                    
                    // Information Notice Card
                    Card {
                        background: Theme.accent.with-alpha(0.08);
                        border-color: Theme.accent.with-alpha(0.3);
                        VerticalLayout {
                            padding: 16px;
                            spacing: 6px;
                            Heading { text: "디스크 통째 백업이란?"; font-size: 15px; color: Theme.accent; }
                            Hint { text: "파일 단위가 아닌 드라이브 섹터 전체를 이미지 파일(.qblk) 하나로 복제합니다. 윈도우 부팅 불가 또는 디스크 고장 시 컴퓨터 전체를 되살릴 수 있습니다."; }
                        }
                    }

                    // Step 1: Drive Volume Capture
                    Card {
                        VerticalLayout {
                            padding: 16px;
                            spacing: 10px;
                            Heading { text: "1. 드라이브 전체 백업 생성"; }
                            Hint { text: "백업할 드라이브를 선택하세요. VSS 스냅샷으로 실행 중인 시스템도 안전하게 복제됩니다."; }
                            
                            HorizontalLayout {
                                spacing: 10px;
                                alignment: start;
                                for d in root.drives: Rectangle {
                                    height: 56px;
                                    width: 160px;
                                    border-radius: 8px;
                                    border-width: 2px;
                                    border-color: root.eff-drive == d.name ? Theme.accent : Theme.line;
                                    background: root.eff-drive == d.name ? Theme.accent.with-alpha(0.14) : Theme.card;
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 2px;
                                        Text { text: d.name + (d.repo ? " [보관소]" : ""); color: Theme.text; font-size: 13px; font-weight: 700; horizontal-alignment: center; }
                                        Text { text: "사용 " + d.used; color: Theme.muted; font-size: 11px; horizontal-alignment: center; }
                                    }
                                    TouchArea { clicked => { root.sel-drive = d.name; } }
                                }
                            }
                            
                            HorizontalLayout {
                                alignment: start;
                                Btn { text: "⚡ " + root.eff-drive + " 드라이브 백업 이미지 생성"; kind: 1; height: 38px; clicked => { root.capture-volume(root.eff-drive); } }
                            }
                        }
                    }

                    // Step 2: Existing Images
                    Card {
                        VerticalLayout {
                            padding: 16px;
                            spacing: 10px;
                            Heading { text: "2. 보관된 디스크 이미지 관리 및 추출"; }
                            Hint { text: "생성된 이미지의 무결성을 검사하거나, 일반 VHD/IMG 파일로 풀어서 내용을 확인할 수 있습니다."; }
                            
                            if root.images.length == 0: Text { text: "보관함에 저장된 디스크 이미지가 아직 없습니다."; color: Theme.muted; font-size: 12px; }
                            
                            for im in root.images: Rectangle {
                                height: 40px;
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: root.img-path == im.path ? Theme.accent : Theme.line;
                                background: root.img-path == im.path ? Theme.accent.with-alpha(0.12) : Theme.card;
                                TouchArea { clicked => { root.img-path = im.path; root.confirm-del = ""; } }
                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 8px;
                                    spacing: 12px;
                                    Text { text: im.name; color: Theme.text; font-size: 13px; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                    Text { text: im.size; color: Theme.muted; font-size: 12px; vertical-alignment: center; }
                                    Text { text: im.when; color: Theme.muted; font-size: 12px; vertical-alignment: center; }
                                    if root.confirm-del != im.path: Btn { text: "삭제"; kind: 2; height: 26px; clicked => { root.confirm-del = im.path; root.img-path = im.path; } }
                                    if root.confirm-del == im.path: Text { text: "되돌릴 수 없음!"; color: Theme.danger; font-size: 12px; vertical-alignment: center; font-weight: 700; }
                                    if root.confirm-del == im.path: Btn { text: "정말 삭제"; kind: 2; height: 26px; clicked => { root.delete-image(im.path); root.confirm-del = ""; } }
                                    if root.confirm-del == im.path: Btn { text: "취소"; height: 26px; clicked => { root.confirm-del = ""; } }
                                }
                            }
                            
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: end;
                                Btn { text: "무결성 검사만 수행"; clicked => { root.verify-image(root.img-path); } }
                                Btn { text: "새 파일로 꺼내기"; kind: 1; clicked => { root.restore-image(root.img-path, ""); } }
                            }
                        }
                    }

                    // Step 3: Raw Image Conversion
                    Card {
                        VerticalLayout {
                            padding: 16px;
                            spacing: 10px;
                            Heading { text: "3. 외산 이미지 파일 변환 (VHD/RAW/IMG)"; }
                            Hint { text: "타 프로그램으로 생성된 디스크 이미지를 감지하여 Kova 형식(.qblk)으로 고속 변환합니다."; }
                            
                            for im in root.conv-cands: Rectangle {
                                height: 36px;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: root.conv-src == im.path ? Theme.accent : Theme.line;
                                background: root.conv-src == im.path ? Theme.accent.with-alpha(0.12) : Theme.card;
                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    spacing: 12px;
                                    Text { text: im.path; color: Theme.text; font-size: 13px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                    Text { text: im.size; color: Theme.muted; font-size: 12px; vertical-alignment: center; }
                                }
                                TouchArea { clicked => { root.conv-src = im.path; } }
                            }
                            
                            HorizontalLayout {
                                alignment: end;
                                spacing: 8px;
                                Btn { text: "다시 검색"; clicked => { root.scan-convert(); } }
                                Btn { text: "Kova 형식으로 변환"; kind: 1; clicked => { root.capture-image(root.conv-src, ""); } }
                            }
                        }
                    }

                    // Step 4: Direct Volume Restore (Dangerous)
                    Card {
                        border-color: Theme.danger.with-alpha(0.4);
                        VerticalLayout {
                            padding: 16px;
                            spacing: 10px;
                            Heading { text: "4. 물리 드라이브에 직접 덮어쓰기 복원 (고급/위험)"; }
                            Text { text: "경고: 대상 드라이브의 기존 데이터가 영구히 소멸됩니다. Kova가 관리자 권한으로 실행되어 있어야 합니다."; color: Theme.danger; font-size: 12px; wrap: word-wrap; }
                            Field { text <=> root.vol-img; placeholder: "복원할 이미지 파일(.qblk) 전체 경로"; }
                            HorizontalLayout {
                                spacing: 8px;
                                Field { text <=> root.vol-letter; placeholder: "대상 드라이브 문자 (예: E)"; width: 220px; }
                                Btn { text: "드라이브 상태 확인"; clicked => { root.volume-check(root.vol-letter); } }
                            }
                            Field { text <=> root.vol-phrase; placeholder: "확인 문구를 정확히 입력해야 잠금이 해제됩니다"; }
                            Btn { text: "⚠️ 드라이브 직접 복원 실행 (영구 파괴)"; kind: 2; clicked => { root.restore-volume(root.vol-img, root.vol-letter, root.vol-phrase); } }
                            if root.volume-text != "": Text { text: root.volume-text; color: Theme.warn; font-size: 13px; wrap: word-wrap; }
                        }
                    }

                    // Step 5: WinPE Recovery Media Builder
                    Card {
                        VerticalLayout {
                            padding: 16px;
                            spacing: 10px;
                            Heading { text: "5. 비상 부팅 복구 미디어(WinPE ISO) 제작"; }
                            Hint { text: "Windows가 부팅되지 않을 때 USB로 부팅해 C: 드라이브를 통째 복원하는 WinPE 복구 ISO를 생성합니다. (Windows ADK 필요, 관리자 권한)"; }
                            Field { text <=> root.pe-iso-out; placeholder: "출력 ISO 경로 (비우면 바탕화면 Kova2_WinPE_Recovery.iso)"; }
                            HorizontalLayout {
                                spacing: 8px;
                                Field { text <=> root.pe-drivers-dir; placeholder: "추가 드라이버 폴더 (비우면 자동 수집된 폴더 자동 연결)"; horizontal-stretch: 1; }
                                Btn {
                                    text: "⚡ 드라이버 자동 수집 (DISM)";
                                    clicked => { root.export-drivers(); }
                                }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: end;
                                Btn { text: "WinPE 복구 ISO 생성"; kind: 1; clicked => { root.build-pe-iso(root.pe-iso-out, root.pe-drivers-dir); } }
                            }
                            if root.pe-text != "": Text { text: root.pe-text; color: Theme.muted; font-size: 13px; wrap: word-wrap; }
                        }
                    }
                    if root.image-text != "": Text { text: root.image-text; color: Theme.warn; font-size: 13px; wrap: word-wrap; }
                }
            }



                // PAGE 5: PROTECTION & SETTINGS (ADVANCED)
                if root.page == 5: ScrollView {
                    VerticalLayout {
                        spacing: 16px;
                        alignment: start;
                        
                        // Giant Watermark "3" & Header
                        Rectangle {
                            height: 76px;
                            background: transparent;
                            
                            Text {
                                x: parent.width - 90px;
                                y: -24px;
                                text: "3";
                                font-size: 130px;
                                font-weight: 900;
                                color: Theme.dark ? #ffffff0d : #0000000a;
                            }
                            
                            VerticalLayout {
                                alignment: center;
                                spacing: 3px;
                                Text {
                                    text: "STEP 03  •  SETTINGS & RECOVERY UTILITIES";
                                    color: Theme.accent;
                                    font-size: 11px;
                                    font-weight: 700;
                                    letter-spacing: 0.5px;
                                }
                                Text {
                                    text: "Settings & Tools";
                                    color: Theme.text;
                                    font-size: 26px;
                                    font-weight: 800;
                                }
                                Text {
                                    text: "기본 백업 주기, 보관 정책 및 비상 복구 시스템을 구성합니다.";
                                    color: Theme.muted;
                                    font-size: 13px;
                                }
                            }
                        }
                        
                        // 4대 탭 네비게이션 헤더
                        Card {
                            background: Theme.card;
                            border-color: Theme.line;
                            height: 48px;
                            HorizontalLayout {
                                padding: 4px;
                                spacing: 6px;
                                Btn {
                                    text: "⚙ 일반 & 스케줄";
                                    kind: root.settings-tab == 0 ? 1 : 0;
                                    horizontal-stretch: 1;
                                    clicked => { root.settings-tab = 0; root.settings-text = ""; }
                                }
                                Btn {
                                    text: "🔒 보안 & 보호";
                                    kind: root.settings-tab == 1 ? 1 : 0;
                                    horizontal-stretch: 1;
                                    clicked => { root.settings-tab = 1; root.settings-text = ""; }
                                }
                                Btn {
                                    text: "☁ 클라우드 & 알림";
                                    kind: root.settings-tab == 2 ? 1 : 0;
                                    horizontal-stretch: 1;
                                    clicked => { root.settings-tab = 2; root.settings-text = ""; }
                                }
                                Btn {
                                    text: "🚨 비상복구 & 도구";
                                    kind: root.settings-tab == 3 ? 1 : 0;
                                    horizontal-stretch: 1;
                                    clicked => { root.settings-tab = 3; root.settings-text = ""; }
                                }
                            }
                        }

                        // ── TAB 0: 일반 & 스케줄 ──────────────────────────
                        if root.settings-tab == 0: Card {
                            vertical-stretch: 0;
                            VerticalLayout {
                                padding: 18px;
                                spacing: 14px;
                                alignment: start;
                                Heading { text: "기본 백업 주기 및 스케줄"; }
                                // 주기·보관·저장소는 백업(프로파일)마다 따로 저장된다. 여기 칸은 저장되지 않으므로 두지 않고 편집 화면으로 보낸다
                                Hint { text: "자동 백업 주기, 보관 개수·일수, 저장소 위치는 백업(프로파일)마다 따로 정합니다. 아래 버튼으로 백업 설정 화면을 여세요."; }
                                HorizontalLayout {
                                    alignment: start;
                                    Btn { text: "백업 주기·보관·저장소 설정 열기"; clicked => { root.page = 1; } }
                                }

                                HorizontalLayout {
                                    spacing: 12px;
                                    Btn {
                                        text: "잔여 공간·패킹 설정 저장";
                                        kind: 1;
                                        clicked => {
                                            root.save-settings(root.form-min-free, root.form-ransom, root.form-encrypt, root.form-vss, root.form-pack);
                                        }
                                    }
                                    if root.settings-text != "": Text {
                                        text: root.settings-text;
                                        color: Theme.ok;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                            }
                        }

                        if root.settings-tab == 0: Card {
                            VerticalLayout {
                                padding: 18px;
                                spacing: 12px;
                                Heading { text: "운영 성능 및 리소스 설정"; }
                                
                                HorizontalLayout {
                                    spacing: 10px;
                                    Text { text: "최소 잔여 공간 임계치(GB)"; color: Theme.text; font-size: 13px; width: 190px; vertical-alignment: center; }
                                    Field { text <=> root.form-min-free; width: 80px; }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                                Hint { text: "저장소 디스크 여유 공간이 이 값 이하로 떨어지면 자동으로 백업 작업을 중단하여 시스템을 보호합니다."; }
                                
                                HorizontalLayout {
                                    spacing: 10px;
                                    Text { text: "소용량 청크 패킹(Pack)"; color: Theme.text; font-size: 13px; width: 190px; vertical-alignment: center; }
                                    Btn { text: root.form-pack ? "켜짐" : "꺼짐"; kind: root.form-pack ? 1 : 0; clicked => { root.form-pack = !root.form-pack; } }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                                Hint { text: "수만 개의 작은 파일들을 고속 팩 블록으로 묶어 IOPS 병목을 획기적으로 줄입니다."; }

                                HorizontalLayout {
                                    spacing: 10px;
                                    Text { text: "CPU 스레드 / 전송 속도(MB/s)"; color: Theme.text; font-size: 13px; width: 190px; vertical-alignment: center; }
                                    Field { text <=> root.form-max-threads; width: 70px; placeholder: "0"; }
                                    Field { text <=> root.form-bw-limit; width: 70px; placeholder: "0"; }
                                    Btn { text: root.form-pause-battery ? "배터리 일시정지: 켜짐" : "배터리 일시정지: 꺼짐"; kind: root.form-pause-battery ? 1 : 0; clicked => { root.form-pause-battery = !root.form-pause-battery; } }
                                    Btn { text: "운영 설정 저장"; kind: 1; clicked => { root.save-ops-settings(root.form-webhook, root.form-max-threads, root.form-bw-limit, root.form-pause-battery); } }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                                Hint { text: "0은 자동/무제한. CPU 스레드(1~64)와 오프사이트 전송 속도(MB/s)를 제한해 작업 중 PC 부하를 줄입니다."; }
                            }
                        }

                        if root.settings-tab == 0: Card {
                            VerticalLayout {
                                padding: 18px;
                                spacing: 10px;
                                Heading { text: "환경 구성 진단 요약"; }
                                for l in root.setting-lines: Text { 
                                    text: l; 
                                    color: l == "프로파일" ? Theme.text : Theme.muted; 
                                    font-size: 12px; 
                                    font-weight: l == "프로파일" ? 700 : 400; 
                                    wrap: word-wrap; 
                                }
                            }
                        }

                        // ── TAB 1: 보안 & 보호 ──────────────────────────
                        if root.settings-tab == 1: Card {
                            vertical-stretch: 0;
                            VerticalLayout {
                                padding: 18px;
                                spacing: 14px;
                                alignment: start;
                                Heading { text: "보안 및 핵심 무결성 보호"; }
                            
                                HorizontalLayout {
                                    spacing: 10px;
                                    Text { text: "랜섬웨어 변조 방지 잠금"; color: Theme.text; font-size: 13px; width: 190px; vertical-alignment: center; }
                                    Btn { text: root.form-ransom ? "켜짐" : "꺼짐"; kind: root.form-ransom ? 1 : 0; clicked => { root.form-ransom = !root.form-ransom; } }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                                Hint { text: "악성코드나 비인가 프로세스가 백업 보관소를 변조하거나 삭제할 수 없도록 ACL을 잠급니다."; }
                                
                                HorizontalLayout {
                                    spacing: 10px;
                                    Text { text: "사용 중인 파일 VSS 복제"; color: Theme.text; font-size: 13px; width: 190px; vertical-alignment: center; }
                                    Btn { text: root.form-vss ? "켜짐" : "꺼짐"; kind: root.form-vss ? 1 : 0; clicked => { root.form-vss = !root.form-vss; } }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                                Hint { text: "오피스/DB 등 타 프로그램이 점유 중인 파일도 Windows VSS 스냅샷으로 누락 없이 백업합니다."; }
                                
                                HorizontalLayout {
                                    spacing: 10px;
                                    Text { text: "AES-256 저장소 암호화"; color: Theme.text; font-size: 13px; width: 190px; vertical-alignment: center; }
                                    Btn { text: root.form-encrypt ? "켜짐" : "꺼짐"; kind: root.form-encrypt ? 1 : 0; clicked => { root.form-encrypt = !root.form-encrypt; } }
                                    Btn { text: "복구 키트 저장"; clicked => { root.export-recovery-kit(); } }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                                Hint { text: "백업 저장소를 군사급 암호화로 보호합니다. 활성화 후 '복구 키트 저장'으로 복구 코드를 안전한 곳에 보관하세요."; }
                                
                                HorizontalLayout {
                                    spacing: 8px;
                                    Btn { text: "보안 설정 저장"; kind: 1; clicked => { root.save-settings(root.form-min-free, root.form-ransom, root.form-encrypt, root.form-vss, root.form-pack); } }
                                    if root.settings-text != "": Text { text: root.settings-text; color: Theme.muted; font-size: 13px; vertical-alignment: center; wrap: word-wrap; horizontal-stretch: 1; }
                                }
                            }
                        }

                        if root.settings-tab == 1: Card {
                            VerticalLayout {
                                padding: 18px;
                                spacing: 12px;
                                Heading { text: "마스터 관리자 암호 및 앱 보안"; }
                                
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text { text: "마스터 관리자 암호"; color: Theme.text; font-size: 13px; width: 190px; vertical-alignment: center; }
                                    Field { text <=> root.form-lock-cur; placeholder: "현재 암호"; secret: true; horizontal-stretch: 1; }
                                    Btn { text: "잠금 해제"; clicked => { root.unlock-app(root.form-lock-cur); } }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Rectangle { width: 190px; }
                                    Field { text <=> root.form-lock-new; placeholder: "새 관리자 암호 (공백 입력 시 암호 해제)"; secret: true; horizontal-stretch: 1; }
                                    Btn { text: "암호 설정/변경"; clicked => { root.set-master(root.form-lock-cur, root.form-lock-new); } }
                                }
                                if root.lock-text != "": Hint { text: root.lock-text; }
                            }
                        }

                        // ── TAB 2: 클라우드 & 알림 ──────────────────────
                        if root.settings-tab == 2: Card {
                            VerticalLayout {
                                padding: 18px;
                                spacing: 10px;
                                Heading { text: "오프사이트 2차 보존 복제소"; }
                                Hint { text: "외장 드라이브 또는 네트워크 NAS 폴더를 지정하면 백업 완료 시점에 자동으로 2차 복사본을 생성합니다."; }
                                for o in root.offsite-rows: HorizontalLayout {
                                    spacing: 8px;
                                    Text { text: o.name; color: Theme.text; font-size: 13px; width: 190px; vertical-alignment: center; wrap: word-wrap; }
                                    le := PathField { text: o.dir; target: "offsite:" + o.id; placeholder: "예: E:\\백업복사본"; horizontal-stretch: 1; pick(k, t) => { root.browse(k, t); } }
                                    Btn { text: "저장"; kind: 1; clicked => { root.save-offsite(o.id, le.text); } }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Btn { text: root.gdrive-connected ? "구글 드라이브 연결 해제" : "구글 드라이브 연결"; kind: 1; clicked => { if (root.gdrive-connected) { root.disconnect-gdrive(); } else { root.connect-gdrive(); } } }
                                    Text { text: root.gdrive-connected ? "연결됨: 백업이 끝나면 구글 드라이브의 'Kova2 Backup' 폴더에 자동 복사합니다. " + root.gdrive-text : root.gdrive-text; color: Theme.muted; font-size: 13px; vertical-alignment: center; wrap: word-wrap; horizontal-stretch: 1; }
                                }
                            }
                        }

                        if root.settings-tab == 2: Card {
                            VerticalLayout {
                                padding: 18px;
                                spacing: 12px;
                                Heading { text: "원격 웹훅 알림 연동"; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text { text: "원격 웹훅 알림 URL"; color: Theme.text; font-size: 13px; width: 190px; vertical-alignment: center; }
                                    Field { text <=> root.form-webhook; placeholder: "https://hooks.slack.com/... 또는 Discord 웹훅"; horizontal-stretch: 1; }
                                    Btn { text: "테스트 발송"; clicked => { root.test-webhook(root.form-webhook); } }
                                }
                                Hint { text: "백업 실패·경고 시 Slack/Discord/HTTP 웹훅으로 즉시 알림을 보냅니다. 비워두면 끕니다."; }
                                if root.settings-text != "": Text { text: root.settings-text; color: Theme.muted; font-size: 13px; wrap: word-wrap; }
                            }
                        }

                        if root.settings-tab == 2: Card {
                            VerticalLayout {
                                padding: 18px;
                                spacing: 10px;
                                Heading { text: "소프트웨어 자동 갱신"; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Btn { text: "최신 버전 확인"; clicked => { root.check-update(); } }
                                    Btn { text: "새 버전 즉시 설치"; kind: 1; clicked => { root.install-update(); } }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                                if root.update-text != "": Text { text: root.update-text; color: Theme.muted; font-size: 13px; wrap: word-wrap; }
                            }
                        }

                        // ── TAB 3: 비상복구 & 도구 ──────────────────────
                        if root.settings-tab == 3: Card {
                            VerticalLayout {
                                padding: 18px;
                                spacing: 12px;
                                Heading { text: "비상 복구 및 시스템 진단 도구"; }
                                
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text { text: "복구 코드로 마스터 키 복원"; color: Theme.text; font-size: 13px; width: 190px; vertical-alignment: center; }
                                    Field { text <=> root.form-recovery; horizontal-stretch: 1; }
                                    Btn { text: "키 복원"; clicked => { root.restore-key(root.form-recovery); } }
                                }
                                Hint { text: "암호화 키 분실 시 내보내 둔 복구 코드를 입력하여 복구 마스터 키를 복원합니다."; }
                                if root.settings-text != "": Text { text: root.settings-text; color: Theme.muted; font-size: 13px; wrap: word-wrap; }
                                
                                HorizontalLayout {
                                    spacing: 8px;
                                    Btn { text: "🔄 복구 훈련 시뮬레이션"; clicked => { root.run-drill(); } }
                                    Btn { text: "📋 시스템 정보 내보내기"; clicked => { root.export-sysinfo(); } }
                                    Btn { text: "⚡ 드라이버 자동 수집 (DISM)"; clicked => { root.export-drivers(); } }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Btn { text: "🩺 진단 로그 덤프 생성"; clicked => { root.make-diag(); } }
                                    Btn { 
                                        text: "📂 백업 저장소 탐색기로 열기"; 
                                        clicked => { 
                                            root.open-repo-dir(root.form-repo != "" ? root.form-repo : root.main-repo); 
                                        } 
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                                if root.diag-text != "": Text { text: root.diag-text; color: Theme.muted; font-size: 13px; wrap: word-wrap; }
                            }
                        }

                        Rectangle { vertical-stretch: 1; }
                    }
                }

            }
        }
    }
}
